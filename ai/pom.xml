<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.frostlake</groupId>
        <artifactId>frostlake-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>frostlake-ai</artifactId>
    <packaging>jar</packaging>

    <name>Frostlake AI</name>
    <description>Optional Cortex AI function pack for Frostlake (SNOWFLAKE.CORTEX.COMPLETE, SENTIMENT,
        SUMMARIZE, TRANSLATE, EMBED_TEXT_*, the AI_ family), contributed to the engine via the
        FunctionProvider ServiceLoader SPI. The functions are answered by a locally-running Ollama server
        configured through frostlake.properties, so Cortex-shaped SQL runs against a model you host rather
        than a paid account. Add this module to the classpath to enable it. Dependency-free beyond the
        engine itself — the Ollama transport is java.net.http.</description>

    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- Compile scope, one direction (ai -> engine); the engine discovers this pack at runtime via
             the FunctionProvider SPI and never depends back on it. -->
        <dependency>
            <groupId>dev.frostlake</groupId>
            <artifactId>frostlake-db</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>dev.frostlake</groupId>
            <artifactId>frostlake-db</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>-Dpolyglot.engine.WarnInterpreterOnly=false</argLine>
                    <excludedGroups>${perf.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- License-header audit (Apache RAT): fails the build at `verify` if any owned .java file is
                 missing the Apache-2.0 header. -->
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>${apache-rat-plugin.version}</version>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <inputExcludes>
                        <inputExclude>/pom.xml</inputExclude>
                        <inputExclude>/.flattened-pom.xml</inputExclude>
                        <inputExclude>/src/main/resources/**</inputExclude>
                        <inputExclude>/src/test/resources/**</inputExclude>
                        <inputExclude>**/*.md</inputExclude>
                        <inputExclude>**/*.log</inputExclude>
                    </inputExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
