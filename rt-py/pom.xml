<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.frostlake</groupId>
        <artifactId>frostlake-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>frostlake-rt-py</artifactId>
    <packaging>jar</packaging>

    <name>Frostlake Python Runtime</name>
    <description>Optional GraalPy-backed Python UDF, UDTF and stored-procedure runtime for Frostlake
        (including the Snowpark session shim), contributed to the engine as a UdfLanguageRuntime
        ServiceLoader SPI. Keeps the GraalVM Python dependencies out of the core frostlake-db artifact —
        add this module to the classpath to enable LANGUAGE PYTHON.</description>

    <!-- Published to Central as its own separate jar; override the parent's deploy skip. -->
    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- The engine: provides the UdfLanguageRuntime SPI this runtime implements. Compile scope,
             one direction (module -> engine); the engine never depends back on this module — it
             discovers the runtime at runtime via ServiceLoader. -->
        <dependency>
            <groupId>dev.frostlake</groupId>
            <artifactId>frostlake-db</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- GraalPy (Python 3) on the shared ${graalvm.version} pin (see the engine pom for why the
             versions must all match and must not be bumped past what the JDK 17 toolchain supports). -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>python</artifactId>
            <version>${graalvm.version}</version>
            <type>pom</type>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>dev.frostlake</groupId>
            <artifactId>frostlake-db</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.frostlake</groupId>
            <artifactId>frostlake-rt-js</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>-Dpolyglot.engine.WarnInterpreterOnly=false</argLine>
                    <excludedGroups>${perf.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- License-header audit (Apache RAT): fails the build at `verify` if any owned .java file is
                 missing the Apache-2.0 header. -->
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>${apache-rat-plugin.version}</version>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <inputExcludes>
                        <inputExclude>/pom.xml</inputExclude>
                        <inputExclude>/.flattened-pom.xml</inputExclude>
                        <inputExclude>/src/main/resources/**</inputExclude>
                        <inputExclude>/src/test/resources/**</inputExclude>
                        <inputExclude>**/*.md</inputExclude>
                        <inputExclude>**/*.log</inputExclude>
                    </inputExcludes>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
