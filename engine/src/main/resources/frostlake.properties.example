# Frostlake SQL Engine Configuration
# Copy this file to frostlake.properties (on the classpath / project dir) or to
# ~/.frostlake/frostlake.properties, and customize. All keys are optional; the
# built-in defaults (the values shown below) apply when a key is absent.

# HTTP Server Configuration
http.port=8080
http.host=localhost
http.maxConnections=100

# Database Defaults
database.default=SNOWFLAKE
schema.default=PUBLIC

# Account Configuration
# The account identifier returned by CURRENT_ACCOUNT() function
# This should be an alphanumeric string that identifies your database instance
account.id=ABC12345

# The account NAME returned by CURRENT_ACCOUNT_NAME() — a different identifier from the locator above
# (on a real account CURRENT_ACCOUNT() and CURRENT_ACCOUNT_NAME() answer different values). Defaults to
# account.id when unset.
#account.name=ABC12345

# The organization returned by CURRENT_ORGANIZATION_NAME().
#organization.name=ABCORG

# The region returned by CURRENT_REGION(). BARE by default, which is what a real account answers; the
# <region_group>.<region> spelling (PUBLIC.AWS_US_EAST_1) belongs to an organization spanning multiple
# region groups, so set it here explicitly if that is the shape you want.
#snowflake.region=AWS_US_EAST_1

# Storage Configuration
storage.inMemory=true

# Persistence Configuration
persistence.enabled=false
# Persisted-data directory (catalog snapshot + per-table data + WAL). Defaults to the SQL_ENGINE_DATA_DIR
# environment variable when set, otherwise <user-home>/.frostlake_engine/data. Uncomment to pin an explicit
# location such as the current working directory:
# persistence.directory=./data
persistence.autoSave=true
persistence.saveIntervalSeconds=60

# Durability (write-ahead log) — off by default; durability matters least for the in-memory local/CI use.
# When enabled, each committed transaction (autocommit statement or explicit BEGIN...COMMIT block) is
# appended to the WAL and fsync'd before COMMIT returns, and replayed on startup to recover committed work.
# NOTE: the WAL and snapshot persistence are alternative restore paths, not additive — while
# durability.walEnabled=true, persistence.enabled is ignored (WAL checkpoint + replay is authoritative);
# restoring an autosave snapshot AND replaying the log would double-apply transactions.
durability.walEnabled=false
# WAL file location. Defaults to <persisted-data directory>/wal.log (see persistence.directory above).
# Uncomment to override explicitly:
# durability.walFile=./data/wal.log
# Write a checkpoint (full state snapshot + log truncation) after this many committed transactions, bounding
# the log's growth and speeding recovery. 0 disables automatic checkpointing.
durability.checkpointInterval=0

# Task scheduler
# Whether the engine arms the task scheduler as it finishes starting, so tasks left in the STARTED state —
# typically by a restore, which writes the state without arming anything — start firing on their schedule
# again. Off by default: it spawns timer threads, and task bodies begin executing against restored data as
# soon as the engine is up, before anyone has looked at the instance. Turn it on for a long-running server
# expected to pick up where it left off across restarts; leave it off for an embedded engine inside another
# process, which should call startTaskScheduler() when it is ready.
# This does NOT gate tasks in general — ALTER TASK ... RESUME starts the scheduler by itself. It only
# decides whether ALREADY-resumed tasks are armed at boot.
tasks.autostart=false

# Command toggles
# REMOVE / RM @stage deletes the files backing a stage on the local filesystem. Off by default as a safety
# guard against accidental data loss; set to true to allow it.
command.removeEnabled=false

# Logging Configuration
logging.level=INFO

# Stage S3 -> local filesystem resolution
# Maps s3://bucket/key references to local files for local/CI testing — both stage file operations
# (LIST / GET / PUT / REMOVE) on S3-backed stages and the JAR(s) named in a UDF/procedure IMPORTS clause
# (by s3:// URL or via an S3-backed @stage). An unmapped key resolves under stage.s3.localRoot as
# <root>/bucket/key.
# Both settings are optional; the defaults below apply when unset.
#
# Fallback base for s3:// resolution (default: <user-home>/.frostlake_stages/s3):
# stage.s3.localRoot=/var/frostlake_stages/s3
# Explicit prefix overrides: ';'-separated 's3prefix=localdir' pairs, longest matching prefix wins:
# stage.s3.localMappings=s3://prod-bucket/lib/=/opt/jars; s3://data/=/srv/data

# GraalPy virtual environment whose installed packages (numpy, pandas, ...) become importable from
# Python UDF/procedure handlers — the local stand-in for Snowflake's PACKAGES=(...) clause. Point it
# at the venv produced by the graalpy-maven-plugin (<externalDirectory>/venv), matching the engine's
# GraalPy version. Optional; a missing directory leaves the standard library only.
# python.venv=/opt/graalpy-packages/venv

# Cortex AI (frostlake-ai module only)
# Where the Cortex functions — SNOWFLAKE.CORTEX.COMPLETE, SENTIMENT, SUMMARIZE, TRANSLATE,
# EMBED_TEXT_*, the AI_ family, SEARCH_PREVIEW — send their prompts. Frostlake answers them with a
# locally-hosted Ollama model rather than a paid account, so Cortex-shaped SQL runs against a model
# you host. Every key is also readable as a system property of the same name.
# Nothing here contacts the server at startup: an engine whose Ollama is not running still starts, and
# only a CALL of one of those functions fails.
#
# Base URL of the Ollama server (default: http://localhost:11434):
# ai.ollama.url=http://localhost:11434
# Model for the text functions (default: llama3.2) — must be pulled: `ollama pull llama3.2`
# ai.ollama.model=llama3.2
# Model for EMBED_TEXT_768 / EMBED_TEXT_1024 / AI_SIMILARITY / SEARCH_PREVIEW
# (default: nomic-embed-text):
# ai.ollama.embedModel=nomic-embed-text
# Per-request timeout in milliseconds (default: 60000):
# ai.ollama.timeoutMs=60000
