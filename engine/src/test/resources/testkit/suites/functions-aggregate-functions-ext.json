{
  "suite": "functions-aggregate-functions-ext",
  "description": "The extended aggregate family over a fixed five-row fixture (values 10..40 plus a NULL row): the statistical aliases STDDEV_SAMP/STDDEV_POP/VAR_SAMP/VAR_POP, the boolean aggregates BOOLOR_AGG / BOOLAND_AGG / BOOLXOR_AGG, the bitwise aggregates BITAND_AGG / BITOR_AGG / BITXOR_AGG, COUNT_IF, MEDIAN over odd and even counts, MODE, ANY_VALUE, APPROX_COUNT_DISTINCT, SKEW, KURTOSIS, CORR, COVAR_POP / COVAR_SAMP, and PERCENTILE_CONT / PERCENTILE_DISC. Converted 1:1 from functions/AggregateFunctionsExtTest (now retired); its @BeforeEach nums fixture is inlined per test. The Java class tested PERCENTILE_CONT and PERCENTILE_DISC by driving their accumulator objects directly, with a comment that the WITHIN GROUP syntax was not yet in the grammar; it is now, so both converted tests run the real SQL and the claims hold on every backend. Java tolerances (0.001, 0.01) become ABS(x - expected) < tolerance predicates where the exact value is irrational, and the plain 10-significant-figure normalisation elsewhere.",
  "tags": ["functions", "converted"],
  "tests": [
    {"name": "stddev-samp-matches-stddev", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT ABS(STDDEV_SAMP(v) - STDDEV(v)) < 0.001 FROM nums", "expect": {"value": "true"}}
    ]},
    {"name": "stddev-pop-over-the-fixture", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT ABS(STDDEV_POP(v) - 11.18) < 0.01 FROM nums", "expect": {"value": "true"}}
    ]},
    {"name": "var-samp-matches-variance", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT ABS(VAR_SAMP(v) - VARIANCE(v)) < 0.001 FROM nums", "expect": {"value": "true"}}
    ]},
    {"name": "var-pop-over-the-fixture", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT VAR_POP(v) FROM nums", "expect": {"value": "125"}}
    ]},
    {"name": "boolor-agg", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT BOOLOR_AGG(flag) FROM nums", "expect": {"value": "true"}}
    ]},
    {"name": "booland-agg", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT BOOLAND_AGG(flag) FROM nums", "expect": {"value": "false"}}
    ]},
    {"name": "booland-agg-over-all-true", "steps": [
      {"sql": "CREATE TABLE allTrue (f BOOLEAN)"},
      {"sql": "INSERT INTO allTrue VALUES (true),(true),(true)"},
      {"sql": "SELECT BOOLAND_AGG(f) FROM allTrue", "expect": {"value": "true"}}
    ]},
    {"name": "boolxor-agg-answers", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT IFF(BOOLXOR_AGG(flag) IS NULL, 'null', 'set') FROM nums", "expect": {"value": "set"}}
    ]},
    {"name": "bitand-agg", "steps": [
