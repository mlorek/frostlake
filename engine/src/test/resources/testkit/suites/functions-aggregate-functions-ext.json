    {"name": "skew-of-a-symmetric-distribution-is-zero", "steps": [
      {"sql": "CREATE TABLE sym (v DOUBLE)"},
      {"sql": "INSERT INTO sym VALUES (1),(2),(3),(4),(5)"},
      {"sql": "SELECT ABS(SKEW(v)) < 0.01 FROM sym", "expect": {"value": "true"}}
