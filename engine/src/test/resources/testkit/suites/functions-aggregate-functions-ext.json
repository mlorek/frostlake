    ]},
    {"name": "any-value-answers", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT IFF(ANY_VALUE(id) IS NULL, 'null', 'set') FROM nums", "expect": {"value": "set"}}
    ]},
    {"name": "approx-count-distinct-is-exact-for-a-small-cardinality", "steps": [
      {"sql": "CREATE TABLE nums (id INTEGER, v DOUBLE, flag BOOLEAN)"},
      {"sql": "INSERT INTO nums VALUES (1,10.0,true),(2,20.0,false),(3,30.0,true),(4,40.0,true),(5,NULL,NULL)"},
      {"sql": "SELECT APPROX_COUNT_DISTINCT(id) FROM nums", "expect": {"value": "5"}}
