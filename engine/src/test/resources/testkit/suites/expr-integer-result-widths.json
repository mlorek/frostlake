{
  "suite": "expr-integer-result-widths",
  "description": "The declared PRECISION of integer-returning functions, live-measured in five distinct widths: lengths and counts 18, bit lengths and HASH 19, positions / collection sizes / temporal differences 9, date parts 2 (4 for the year-and-day-of-year family), DATE_PART and EXTRACT following the width of the PART asked for, the window row counters 18, and an ordinary NUMBER still 38. Converted 1:1 from expressions/IntegerResultWidthTest (now retired).",
  "tags": ["expressions", "converted"],
  "tests": [
    {"name": "a-length-or-count-is-eighteen", "steps": [
      {"sql": "CREATE TABLE iw (s VARCHAR(10), b BINARY(4), a ARRAY, n NUMBER)"},
      {"sql": "INSERT INTO iw SELECT 'abc', TO_BINARY('4142'), ARRAY_CONSTRUCT(1, 2), 5"},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT LENGTH(s) AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT LENGTH(b) AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT LEN(s) AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT OCTET_LENGTH(s) AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT REGEXP_INSTR(s, 'b') AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT REGEXP_COUNT(s, 'b') AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT COUNT(*) AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}},
      {"sql": "CREATE OR REPLACE VIEW iw_v AS SELECT COUNT(s) AS c FROM iw"},
      {"sql": "SHOW COLUMNS IN TABLE test_db.test_schema.iw_v"},
      {"sql": "SELECT \"data_type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "{\"type\":\"FIXED\",\"precision\":18,\"scale\":0,\"nullable\":true}"}}
    ]},
