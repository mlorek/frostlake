    {"name": "the-modulo-operator-on-integers", "steps": [
      {"sql": "SELECT 10 % 3", "expect": {"value": 1}}
    ]},
    {"name": "the-modulo-operator-matches-the-mod-function", "steps": [
      {"sql": "SELECT (17 % 5) = MOD(17, 5)", "expect": {"value": true}}
    ]},
    {"name": "the-modulo-operator-takes-the-dividends-sign", "steps": [
      {"sql": "SELECT -10 % 3", "expect": {"value": -1}}
    ]},
    {"name": "the-modulo-operator-on-decimals", "steps": [
      {"sql": "SELECT 10.5 % 3", "expect": {"value": 1.5}}
    ]},
    {"name": "the-modulo-operator-in-a-column-expression", "steps": [
      {"sql": "CREATE TABLE mod_t (n INTEGER)"},
      {"sql": "INSERT INTO mod_t VALUES (10), (7), (6)"},
      {"sql": "SELECT n FROM mod_t WHERE n % 2 = 0 ORDER BY n", "expect": {"rows": [[6],[10]], "ordered": true}}
    ]},
    {"name": "the-modulo-operator-inside-a-procedure", "steps": [
      {"sql": "CREATE OR REPLACE PROCEDURE p_mod() RETURNS INTEGER LANGUAGE SQL AS $$ DECLARE x INTEGER := 17 % 5; BEGIN RETURN :x; END $$"},
      {"sql": "CALL p_mod()", "expect": {"value": 2}}
    ]}
  ]
