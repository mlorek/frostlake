      {"sql": "INSERT INTO employees VALUES (6, 'Frank', 'HR', 65000, 40)"},
      {"sql": "SELECT name FROM employees WHERE salary > 80000", "expect": {"rows": [["Alice"],["Charlie"],["Eve"]]}}
    ]},
