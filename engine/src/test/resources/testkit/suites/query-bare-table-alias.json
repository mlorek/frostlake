{
  "suite": "query-bare-table-alias",
  "description": "Which keywords may be a BARE (AS-less) table alias: one word from each recovered family (limit, top, type names, scripting words incl. break/continue/raise/return, current_date family, privileges, ...) aliases the table and qualifies columns, while the eleven-plus words that LEAD something in a FROM clause (join words, lateral, using, rlike, into, unique, ...) stay refused; the AS spelling and RLIKE-as-function are unaffected. All live-measured. Converted 1:1 from ddl/BareTableAliasKeywordTest (now retired).",
  "tags": ["query", "converted"],
  "tests": [
    {"name": "every-recovered-keyword-is-a-bare-alias", "steps": [
      {"sql": "CREATE TABLE bta (x NUMBER)"},
      {"sql": "INSERT INTO bta VALUES (7)"},
      {"sql": "SELECT x FROM bta limit", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta top", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta auto", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta primary", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta foreign", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta show", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta merge", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta call", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta commit", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta declare", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta let", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta loop", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta while", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta until", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta open", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta fetch", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta int", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta varchar", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta float", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta boolean", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta variant", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta object", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta array", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta task", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta pipe", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta sequence", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta procedure", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta function", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta view", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta materialized", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta transient", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta over", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta within", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta apply", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta at", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta asc", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta desc", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta end", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta if", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta true", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta false", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta no", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta read", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta write", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta share", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta usage", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta monitor", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta operate", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta ownership", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta current_date", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta current_time", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta current_timestamp", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta current_user", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta case", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta cast", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta constraint", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta default", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta when", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta try_cast", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta prior", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta connect_by_root", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta except", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta break", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta continue", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta raise", "expect": {"value": "7"}},
      {"sql": "SELECT x FROM bta return", "expect": {"value": "7"}}
    ]},
    {"name": "the-bare-alias-can-qualify-a-column", "steps": [
      {"sql": "CREATE TABLE bta (x NUMBER)"},
      {"sql": "INSERT INTO bta VALUES (7)"},
      {"sql": "SELECT limit.x FROM bta limit", "expect": {"value": "7"}}
    ]},
    {"name": "a-clause-leading-keyword-is-not-a-bare-alias", "steps": [
      {"sql": "CREATE TABLE bta (x NUMBER)"},
      {"sql": "INSERT INTO bta VALUES (7)"},
      {"sql": "SELECT x FROM bta asof", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta cross", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta full", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta inner", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta join", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta lateral", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta left", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta match_condition", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta natural", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta right", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta using", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta rlike", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta into", "expect": {"error": {}}},
      {"sql": "SELECT x FROM bta unique", "expect": {"error": {}}}
    ]},
    {"name": "the-as-spelling-still-works", "steps": [
      {"sql": "CREATE TABLE bta (x NUMBER)"},
      {"sql": "INSERT INTO bta VALUES (7)"},
      {"sql": "SELECT x FROM bta AS auto", "expect": {"value": "7"}}
    ]},
    {"name": "rlike-is-still-a-function", "steps": [
      {"sql": "CREATE TABLE bta (x NUMBER)"},
      {"sql": "INSERT INTO bta VALUES (7)"},
      {"sql": "SELECT RLIKE('abc', 'a.*') AS c FROM bta", "expect": {"value": "true", "columns": ["c"]}}
    ]}
  ]
}
