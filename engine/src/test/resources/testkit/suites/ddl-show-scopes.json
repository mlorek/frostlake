    {"name": "terse-projects-the-reduced-column-set", "steps": [
      {"sql": "CREATE TABLE t_terse (id INTEGER)"},
      {"sql": "SHOW TERSE TABLES",
       "expect": {"rowCount": 1, "columns": ["created_on", "name", "kind", "database_name", "schema_name"]}}
    ]},
    {"name": "starts-with-is-a-case-sensitive-prefix-filter", "steps": [
      {"sql": "CREATE TABLE aaa_one (id INTEGER)"},
      {"sql": "CREATE TABLE bbb_two (id INTEGER)"},
      {"sql": "SHOW TABLES STARTS WITH 'AAA'", "expect": {"rowCount": 1}},
      {"sql": "SHOW TABLES STARTS WITH 'aaa'", "expect": {"rowCount": 0}}
    ]},
    {"name": "limit-and-from-paginate-by-name", "steps": [
      {"sql": "CREATE TABLE p3 (id INTEGER)"},
      {"sql": "CREATE TABLE p1 (id INTEGER)"},
      {"sql": "CREATE TABLE p2 (id INTEGER)"},
      {"sql": "SHOW TABLES"},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["P1"], ["P2"], ["P3"]], "ordered": true}},
      {"sql": "SHOW TABLES LIMIT 2"},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["P1"], ["P2"]], "ordered": true}},
      {"sql": "SHOW TABLES LIMIT 10 FROM 'P1'"},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["P2"], ["P3"]], "ordered": true}},
      {"sql": "SHOW TABLES LIMIT 1 FROM 'P1'"},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["P2"]]}},
      {"sql": "SHOW TABLES LIKE 'P%' STARTS WITH 'P' LIMIT 1", "expect": {"rowCount": 1}}
    ]},
    {"name": "listings-are-ordered-by-name-byte-wise", "steps": [
      {"sql": "CREATE TABLE t_b (id INTEGER)"},
      {"sql": "CREATE TABLE \"t_lower\" (id INTEGER)"},
      {"sql": "CREATE TABLE t_a (id INTEGER)"},
      {"sql": "SHOW TABLES"},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["T_A"], ["T_B"], ["t_lower"]], "ordered": true}}
    ]},
    {"name": "limit-zero-is-rejected", "steps": [
      {"sql": "CREATE TABLE lz (id INTEGER)"},
      {"sql": "SHOW TABLES LIMIT 0", "expect": {"error": {"messageContains": "must be greater than 0"}}},
      {"sql": "SHOW TABLES LIMIT 1", "expect": {"rowCount": 1}}
    ]},
    {"name": "primary-keys-list-for-schema-database-and-account-scopes", "steps": [
