      {"sql": "USE DATABASE fl_scope_b"},
      {"sql": "USE SCHEMA public"},
      {"sql": "CREATE TABLE b_tbl (id INTEGER)"},
      {"sql": "CREATE SCHEMA fl_scope_a.extra"},
      {"sql": "CREATE TABLE fl_scope_a.extra.z_tbl (id INTEGER)"},
