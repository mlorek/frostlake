       "expect": {"rows": [["FL_SCOPE_A.EXTRA.Z_TBL"], ["FL_SCOPE_A.PUBLIC.A_TBL"], ["FL_SCOPE_B.PUBLIC.B_TBL"]], "ordered": true}},
