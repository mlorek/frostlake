      {"sql": "SHOW IMPORTED KEYS"},
      {"sql": "SELECT COUNT(*) >= 1 FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW IMPORTED KEYS IN ACCOUNT"},
      {"sql": "SELECT COUNT(*) >= 1 FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}}
    ]},
    {"name": "show-columns-variants", "steps": [
      {"sql": "CREATE TABLE c_one (id INTEGER, label VARCHAR)"},
      {"sql": "CREATE TABLE c_two (other INTEGER)"},
      {"sql": "SHOW COLUMNS", "expect": {"rowCount": 3}},
      {"sql": "SELECT COUNT_IF(\"table_name\" = 'C_TWO') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "1"}},
      {"sql": "SHOW COLUMNS LIKE 'LAB%' IN TABLE c_one", "expect": {"rowCount": 1}},
      {"sql": "CREATE VIEW c_view (vc) AS SELECT id FROM c_one"},
      {"sql": "SHOW COLUMNS IN VIEW c_view", "expect": {"error": {"messageContains": "Must specify the full search path"}}},
      {"sql": "SHOW COLUMNS IN VIEW test_db.test_schema.c_view", "expect": {"rowCount": 1}},
      {"sql": "SELECT UPPER(\"column_name\") FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "VC"}}
    ]},
    {"name": "application-and-class-scopes-refuse-like-live", "steps": [
      {"sql": "SHOW ICEBERG TABLES", "expect": {"rowCount": 0}},
      {"sql": "SHOW TERSE ICEBERG TABLES IN test_db.test_schema", "expect": {"rowCount": 0}},
      {"sql": "SHOW PROCEDURES LIKE 'foo' IN APPLICATION app",
       "expect": {"error": {"messageContains": "SQL compilation error:\nApplication 'APP' does not exist or not authorized."}}},
      {"sql": "SHOW PROCEDURES LIKE 'foo' IN APPLICATION PACKAGE pkg",
       "expect": {"error": {"messageContains": "SQL compilation error:\nApplication package 'PKG' does not exist or not authorized."}}},
      {"sql": "SHOW FUNCTIONS LIKE 'foo' IN CLASS bla",
       "expect": {"error": {"messageContains": "SQL compilation error: Object type or Class 'BLA' does not exist or not authorized."}}},
      {"sql": "SHOW FUNCTIONS IN APPLICATION app",
       "expect": {"error": {"messageContains": "SQL compilation error:\nApplication 'APP' does not exist or not authorized."}}},
      {"sql": "SHOW PROCEDURES IN CLASS c1",
       "expect": {"error": {"messageContains": "SQL compilation error: Object type or Class 'C1' does not exist or not authorized."}}},
      {"sql": "SHOW PROCEDURES IN APPLICATION \"app\"",
       "expect": {"error": {"messageContains": "SQL compilation error:\nApplication '\"app\"' does not exist or not authorized."}}}
    ]},
    {"name": "account-wide-listings", "steps": [
      {"sql": "CREATE VIEW acc_v AS SELECT 1 AS c"},
      {"sql": "CREATE SEQUENCE acc_seq"},
