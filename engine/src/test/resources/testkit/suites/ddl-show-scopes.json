      {"sql": "SHOW TERSE PRIMARY KEYS IN test_db.test_schema.pk_t", "expect": {"rowCount": 1}}
    ]},
    {"name": "imported-keys-list-foreign-key-columns", "steps": [
      {"sql": "CREATE TABLE fk_parent (id INTEGER PRIMARY KEY)"},
      {"sql": "CREATE TABLE fk_child (id INTEGER, pid INTEGER, CONSTRAINT fk_child_parent FOREIGN KEY (pid) REFERENCES fk_parent (id))"},
      {"sql": "SHOW IMPORTED KEYS IN TABLE fk_child", "expect": {"rowCount": 1}},
      {"sql": "SELECT \"fk_table_name\", UPPER(\"fk_column_name\"), CONTAINS(UPPER(\"pk_table_name\"), 'FK_PARENT') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
