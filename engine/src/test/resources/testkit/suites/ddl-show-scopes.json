{
  "suite": "ddl-show-scopes",
  "description": "SHOW scope and suffix surface, all live-measured: qualified IN SCHEMA other_db.public answers about the named database and IN ACCOUNT spans every database (per kind, with the database-major/schema/name account ordering pinned); the unscoped listing stays confined to the current schema; TERSE projection, case-sensitive STARTS WITH, LIMIT n [FROM 'name'] by-name pagination over byte-wise name order, LIMIT 0 rejected; PRIMARY/UNIQUE/IMPORTED KEYS scope forms including the bare qualified-name TABLE scope; SHOW COLUMNS variants (nameless, LIKE ... IN TABLE, IN VIEW demanding the full search path); ICEBERG listings empty while APPLICATION / APPLICATION PACKAGE / CLASS scopes refuse with live's exact messages; account-wide listings; the inert HISTORY and WITH PRIVILEGES modifiers; and SHOW TABLES' full 27-column live layout with its feature-flag tail read back through RESULT_SCAN. Converted 1:1 from ddl/ShowQualifiedAndAccountScopeTest + ddl/ShowSuffixAndScopeTest + ddl/ShowTablesLayoutTest (now retired).",
  "tags": ["ddl", "converted"],
  "tests": [
    {"name": "qualified-schema-reference-answers-about-the-named-database", "steps": [
      {"sql": "CREATE OR REPLACE DATABASE fl_scope_a"},
      {"sql": "USE DATABASE fl_scope_a"},
      {"sql": "USE SCHEMA public"},
      {"sql": "CREATE STAGE a_stage"},
      {"sql": "CREATE TABLE a_tbl (id INTEGER)"},
      {"sql": "CREATE STREAM a_stream ON TABLE a_tbl"},
      {"sql": "CREATE SEQUENCE a_seq"},
      {"sql": "CREATE FILE FORMAT a_ff TYPE = CSV"},
      {"sql": "CREATE TAG a_tag"},
      {"sql": "CREATE MASKING POLICY a_mp AS (v VARCHAR) RETURNS VARCHAR -> v"},
      {"sql": "CREATE ROW ACCESS POLICY a_rap AS (v VARCHAR) RETURNS BOOLEAN -> TRUE"},
      {"sql": "CREATE TASK a_task SCHEDULE = '1 MINUTE' AS SELECT 1"},
      {"sql": "CREATE OR REPLACE DATABASE fl_scope_b"},
      {"sql": "USE DATABASE fl_scope_b"},
      {"sql": "USE SCHEMA public"},
      {"sql": "CREATE STAGE b_stage"},
      {"sql": "CREATE TABLE b_tbl (id INTEGER)"},
      {"sql": "CREATE STREAM b_stream ON TABLE b_tbl"},
      {"sql": "CREATE SEQUENCE b_seq"},
      {"sql": "CREATE FILE FORMAT b_ff TYPE = CSV"},
      {"sql": "CREATE TAG b_tag"},
      {"sql": "CREATE MASKING POLICY b_mp AS (v VARCHAR) RETURNS VARCHAR -> v"},
      {"sql": "CREATE ROW ACCESS POLICY b_rap AS (v VARCHAR) RETURNS BOOLEAN -> TRUE"},
      {"sql": "CREATE TASK b_task SCHEDULE = '1 MINUTE' AS SELECT 1"},
      {"sql": "SHOW TABLES IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_TBL'), COUNT_IF(UPPER(\"name\") = 'B_TBL') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW OBJECTS IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_TBL'), COUNT_IF(UPPER(\"name\") = 'B_TBL') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW STAGES IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_STAGE'), COUNT_IF(UPPER(\"name\") = 'B_STAGE') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW STREAMS IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_STREAM'), COUNT_IF(UPPER(\"name\") = 'B_STREAM') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW TASKS IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_TASK'), COUNT_IF(UPPER(\"name\") = 'B_TASK') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW SEQUENCES IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_SEQ'), COUNT_IF(UPPER(\"name\") = 'B_SEQ') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW FILE FORMATS IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_FF'), COUNT_IF(UPPER(\"name\") = 'B_FF') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW TAGS IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_TAG'), COUNT_IF(UPPER(\"name\") = 'B_TAG') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW MASKING POLICIES IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_MP'), COUNT_IF(UPPER(\"name\") = 'B_MP') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "SHOW ROW ACCESS POLICIES IN SCHEMA fl_scope_a.public"},
      {"sql": "SELECT COUNT_IF(UPPER(\"name\") = 'A_RAP'), COUNT_IF(UPPER(\"name\") = 'B_RAP') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "0"]]}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "USE SCHEMA test_schema"},
      {"sql": "DROP DATABASE fl_scope_a"},
      {"sql": "DROP DATABASE fl_scope_b"}
    ]},
