{
  "suite": "features-tag",
  "description": "CREATE / ALTER / DROP / COMMENT ON / SHOW / DESCRIBE TAG, read back through SHOW TAGS cells (name, allowed_values, comment, database_name, schema_name) so every check runs against whichever engine executed the DDL. ALLOWED_VALUES is stored as a JSON array string and is added to, dropped from and unset in place. MASKING is not a tag property: it is refused at compile time with invalid property 'MASKING' for 'TAG', both at CREATE and at ALTER, and the CREATE refusal leaves no tag behind. Converted 1:1 from features/TagTest (now retired). The two DESCRIBE TAG tests keep the class's live skip - DESCRIBE TAG answers \"Unsupported feature 'TAG'\" on a Standard-edition account.",
  "tags": ["features", "converted"],
  "tests": [
    {"name": "create-a-simple-tag", "steps": [
      {"sql": "CREATE TAG cost_center"},
      {"sql": "SHOW TAGS LIKE 'cost_center'"},
      {"sql": "SELECT \"name\", IFF(\"allowed_values\" IS NULL, 'null', 'set') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'COST_CENTER'",
       "expect": {"rows": [["COST_CENTER", "null"]]}}
    ]},
    {"name": "create-a-tag-with-allowed-values", "steps": [
      {"sql": "CREATE TAG department ALLOWED_VALUES 'HR', 'IT', 'FINANCE', 'SALES'"},
      {"sql": "SHOW TAGS LIKE 'department'"},
      {"sql": "SELECT \"name\", \"allowed_values\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'DEPARTMENT'",
       "expect": {"rows": [["DEPARTMENT", "[\"HR\",\"IT\",\"FINANCE\",\"SALES\"]"]]}}
    ]},
    {"name": "create-tag-with-masking-is-refused", "steps": [
      {"sql": "CREATE TAG sensitive_data MASKING = TRUE",
       "expect": {"error": {"messageContains": "invalid property 'MASKING' for 'TAG'"}}},
      {"sql": "SHOW TAGS LIKE 'sensitive_data'", "expect": {"rowCount": 0}}
    ]},
    {"name": "alter-tag-set-masking-is-refused", "steps": [
      {"sql": "CREATE TAG alter_mask_tag"},
      {"sql": "ALTER TAG alter_mask_tag SET MASKING = TRUE",
       "expect": {"error": {"messageContains": "invalid property 'MASKING' for 'TAG'"}}}
    ]},
    {"name": "create-a-tag-with-a-comment", "steps": [
      {"sql": "CREATE TAG project_code COMMENT = 'Project identifier tag'"},
      {"sql": "SHOW TAGS LIKE 'project_code'"},
      {"sql": "SELECT \"name\", \"comment\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'PROJECT_CODE'",
       "expect": {"rows": [["PROJECT_CODE", "Project identifier tag"]]}}
    ]},
    {"name": "create-tag-if-not-exists-is-a-no-op", "steps": [
      {"sql": "CREATE TAG cost_center"},
      {"sql": "CREATE TAG IF NOT EXISTS cost_center"},
      {"sql": "SHOW TAGS LIKE 'cost_center'", "expect": {"rowCount": 1}}
    ]},
    {"name": "a-duplicate-create-tag-fails", "steps": [
      {"sql": "CREATE TAG cost_center"},
      {"sql": "CREATE TAG cost_center", "expect": {"error": {}}}
    ]},
    {"name": "show-tags-lists-every-tag", "steps": [
      {"sql": "CREATE TAG cost_center"},
      {"sql": "CREATE TAG department"},
      {"sql": "SHOW TAGS"},
      {"sql": "SELECT COUNT_IF(\"name\" = 'COST_CENTER'), COUNT_IF(\"name\" = 'DEPARTMENT') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["1", "1"]]}}
    ]},
    {"name": "show-tags-carries-database-and-schema", "steps": [
      {"sql": "CREATE TAG department ALLOWED_VALUES 'HR', 'IT'"},
      {"sql": "SHOW TAGS LIKE 'department'"},
      {"sql": "SELECT \"database_name\", \"schema_name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'DEPARTMENT'",
       "expect": {"rows": [["TEST_DB", "TEST_SCHEMA"]]}}
    ]},
    {"name": "alter-tag-add-allowed-values", "steps": [
      {"sql": "CREATE TAG department ALLOWED_VALUES 'HR', 'IT', 'FINANCE', 'SALES'"},
      {"sql": "ALTER TAG department ADD ALLOWED_VALUES 'MARKETING', 'OPERATIONS'"},
      {"sql": "SHOW TAGS LIKE 'department'"},
      {"sql": "SELECT \"allowed_values\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'DEPARTMENT'",
       "expect": {"value": "[\"HR\",\"IT\",\"FINANCE\",\"SALES\",\"MARKETING\",\"OPERATIONS\"]"}}
    ]},
    {"name": "alter-tag-drop-allowed-values", "steps": [
      {"sql": "CREATE TAG department ALLOWED_VALUES 'HR', 'IT', 'FINANCE', 'SALES'"},
      {"sql": "ALTER TAG department DROP ALLOWED_VALUES 'SALES'"},
      {"sql": "SHOW TAGS LIKE 'department'"},
      {"sql": "SELECT \"allowed_values\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'DEPARTMENT'",
       "expect": {"value": "[\"HR\",\"IT\",\"FINANCE\"]"}}
    ]},
    {"name": "alter-tag-unset-allowed-values", "steps": [
      {"sql": "CREATE TAG department ALLOWED_VALUES 'HR', 'IT'"},
      {"sql": "ALTER TAG department UNSET ALLOWED_VALUES"},
      {"sql": "SHOW TAGS LIKE 'department'"},
      {"sql": "SELECT IFF(\"allowed_values\" IS NULL, 'null', 'set') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'DEPARTMENT'",
       "expect": {"value": "null"}}
    ]},
    {"name": "alter-tag-set-comment", "steps": [
      {"sql": "CREATE TAG cost_center"},
      {"sql": "ALTER TAG cost_center SET COMMENT = 'Updated cost center tag'"},
      {"sql": "SHOW TAGS LIKE 'cost_center'"},
      {"sql": "SELECT \"comment\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'COST_CENTER'",
       "expect": {"value": "Updated cost center tag"}}
    ]},
    {"name": "comment-on-tag", "steps": [
      {"sql": "CREATE TAG project_code"},
      {"sql": "COMMENT ON TAG project_code IS 'Project tracking identifier'"},
      {"sql": "SHOW TAGS LIKE 'project_code'"},
      {"sql": "SELECT \"comment\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'PROJECT_CODE'",
       "expect": {"value": "Project tracking identifier"}}
    ]},
    {"name": "comment-if-exists-on-a-missing-tag-is-a-no-op", "steps": [
      {"sql": "COMMENT IF EXISTS ON TAG nonexistent_tag IS 'This should not fail'"}
    ]},
    {"name": "alter-tag-rename-to", "steps": [
      {"sql": "CREATE TAG project_code"},
      {"sql": "ALTER TAG project_code RENAME TO project_id"},
      {"sql": "SHOW TAGS LIKE 'project_code'", "expect": {"rowCount": 0}},
      {"sql": "SHOW TAGS LIKE 'project_id'", "expect": {"rowCount": 1}},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "PROJECT_ID"}}
    ]},
    {"name": "drop-tag", "steps": [
      {"sql": "CREATE TAG sensitive_data"},
      {"sql": "DROP TAG sensitive_data"},
      {"sql": "SHOW TAGS LIKE 'sensitive_data'", "expect": {"rowCount": 0}}
    ]},
    {"name": "drop-tag-if-exists-is-a-no-op", "steps": [
      {"sql": "DROP TAG IF EXISTS nonexistent_tag"}
    ]},
    {"name": "dropping-a-nonexistent-tag-fails", "steps": [
      {"sql": "DROP TAG nonexistent_tag", "expect": {"error": {}}}
    ]},
    {"name": "altering-a-nonexistent-tag-fails", "steps": [
      {"sql": "ALTER TAG nonexistent_tag SET COMMENT = 'test'", "expect": {"error": {}}}
    ]},
    {"name": "describe-tag-reports-the-name-property",
     "skip": {"backends": ["snowflake"], "reason": "DESCRIBE TAG answers \"Unsupported feature 'TAG'\" on a Standard-edition account, so its shape is asserted embedded only"},
     "steps": [
      {"sql": "CREATE TAG department ALLOWED_VALUES 'HR', 'IT'"},
      {"sql": "DESCRIBE TAG department"},
      {"sql": "SELECT \"property\", \"value\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) LIMIT 1",
       "expect": {"rows": [["name", "DEPARTMENT"]]}}
    ]},
    {"name": "describing-a-nonexistent-tag-fails",
     "skip": {"backends": ["snowflake"], "reason": "DESCRIBE TAG answers \"Unsupported feature 'TAG'\" on a Standard-edition account, so its shape is asserted embedded only"},
     "steps": [
      {"sql": "DESCRIBE TAG nonexistent_tag", "expect": {"error": {}}}
    ]}
  ]
}
