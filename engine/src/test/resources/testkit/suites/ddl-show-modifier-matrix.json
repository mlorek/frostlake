{
  "suite": "ddl-show-modifier-matrix",
  "description": "Which SHOW listings act on TERSE / STARTS WITH / LIMIT and which merely accept them (every case a live transcription): TABLES/VIEWS/STREAMS/TASKS filter STARTS WITH and paginate; STAGES/SEQUENCES/FILE FORMATS/WAREHOUSES/TAGS(STARTS WITH only)/routines/COLUMNS/PIPES accept and drop the modifiers while LIKE still filters; TAGS is the asymmetric listing (honours LIMIT, ignores STARTS WITH); TERSE synthesises kind on VIEWS (MATERIALIZED_VIEW included), keeps the five-column shape for SCHEMAS/DATABASES (null schema kind, STANDARD for an ordinary database), adds tableOn/schedule sixth columns for STREAMS/TASKS, has its own ROLES/USERS subsets, and is inert on the dozen listings that do not trim (verified by full column pins plus row-count equality via a session variable). Converted 1:1 from ddl/ShowModifierMatrixTest (now retired).",
  "tags": ["ddl", "converted"],
  "tests": [
    {"name": "starts-with-filters-tables-views-and-streams", "steps": [
      {"sql": "CREATE TABLE m_a (id INTEGER)"},
      {"sql": "CREATE TABLE m_b (id INTEGER)"},
      {"sql": "CREATE VIEW v_a AS SELECT 1 AS c"},
      {"sql": "CREATE VIEW v_b AS SELECT 2 AS c"},
      {"sql": "CREATE STREAM s_a ON TABLE m_a"},
      {"sql": "CREATE STREAM s_b ON TABLE m_b"},
      {"sql": "SHOW TABLES STARTS WITH 'M'", "expect": {"rowCount": 2}},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) ORDER BY \"name\"",
       "expect": {"rows": [["M_A"], ["M_B"]], "ordered": true}},
      {"sql": "SHOW TABLES STARTS WITH 'ZZZ'", "expect": {"rowCount": 0}},
      {"sql": "SHOW VIEWS STARTS WITH 'V'", "expect": {"rowCount": 2}},
      {"sql": "SHOW STREAMS STARTS WITH 'ZZZ'", "expect": {"rowCount": 0}},
      {"sql": "SHOW STREAMS", "expect": {"rowCount": 2}}
    ]},
    {"name": "starts-with-is-accepted-and-ignored-on-stages-sequences-file-formats-and-tags", "steps": [
      {"sql": "CREATE SEQUENCE q_a"},
      {"sql": "CREATE SEQUENCE q_b"},
      {"sql": "CREATE STAGE g_a"},
      {"sql": "CREATE STAGE g_b"},
      {"sql": "CREATE FILE FORMAT ff_a TYPE = CSV"},
      {"sql": "CREATE FILE FORMAT ff_b TYPE = JSON"},
      {"sql": "CREATE TAG tg_a"},
      {"sql": "CREATE TAG tg_b"},
      {"sql": "SHOW STAGES STARTS WITH 'ZZZ'", "expect": {"rowCount": 2}},
      {"sql": "SHOW STAGES", "expect": {"rowCount": 2}},
      {"sql": "SHOW SEQUENCES STARTS WITH 'ZZZ'", "expect": {"rowCount": 2}},
      {"sql": "SHOW FILE FORMATS STARTS WITH 'ZZZ'", "expect": {"rowCount": 2}},
      {"sql": "SHOW TAGS STARTS WITH 'ZZZ'", "expect": {"rowCount": 2}},
      {"sql": "SHOW WAREHOUSES STARTS WITH 'ZZZ'"},
      {"sql": "SELECT COUNT(*) >= 1 FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW STAGES LIKE 'ZZZ%'", "expect": {"rowCount": 0}}
    ]},
    {"name": "routine-listings-accept-and-ignore-starts-with-and-limit", "steps": [
      {"sql": "CREATE FUNCTION rf(x INTEGER) RETURNS INTEGER AS 'x + 1'"},
      {"sql": "SHOW FUNCTIONS"},
      {"sql": "SET fn_all = (SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())))"},
      {"sql": "SELECT $fn_all > 2", "expect": {"value": "true"}},
      {"sql": "SHOW FUNCTIONS STARTS WITH 'ZZZ'"},
      {"sql": "SELECT COUNT(*) = $fn_all FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW FUNCTIONS LIMIT 2"},
      {"sql": "SELECT COUNT(*) = $fn_all FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW PROCEDURES"},
      {"sql": "SET pr_all = (SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())))"},
      {"sql": "SHOW PROCEDURES LIMIT 1"},
      {"sql": "SELECT COUNT(*) = $pr_all FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}}
    ]},
    {"name": "show-columns-accepts-and-ignores-starts-with-and-limit", "steps": [
      {"sql": "CREATE TABLE c_one (id INTEGER, txt VARCHAR)"},
      {"sql": "SHOW COLUMNS", "expect": {"rowCount": 2}},
      {"sql": "SHOW COLUMNS STARTS WITH 'I'", "expect": {"rowCount": 2}},
      {"sql": "SHOW COLUMNS LIMIT 1", "expect": {"rowCount": 2}}
    ]},
    {"name": "tags-honour-limit-but-ignore-starts-with", "steps": [
      {"sql": "CREATE TAG tg_a"},
      {"sql": "CREATE TAG tg_b"},
      {"sql": "SHOW TAGS", "expect": {"rowCount": 2}},
      {"sql": "SHOW TAGS LIMIT 1", "expect": {"rowCount": 1}},
      {"sql": "SHOW TAGS STARTS WITH 'ZZZ'", "expect": {"rowCount": 2}}
    ]},
    {"name": "limit-is-accepted-and-ignored-on-stages-sequences-and-file-formats", "steps": [
      {"sql": "CREATE SEQUENCE q_a"},
      {"sql": "CREATE SEQUENCE q_b"},
      {"sql": "CREATE STAGE g_a"},
      {"sql": "CREATE STAGE g_b"},
      {"sql": "CREATE FILE FORMAT ff_a TYPE = CSV"},
      {"sql": "CREATE FILE FORMAT ff_b TYPE = JSON"},
      {"sql": "SHOW SEQUENCES LIMIT 1", "expect": {"rowCount": 2}},
      {"sql": "SHOW STAGES LIMIT 1", "expect": {"rowCount": 2}},
      {"sql": "SHOW FILE FORMATS LIMIT 1", "expect": {"rowCount": 2}},
      {"sql": "SHOW WAREHOUSES LIMIT 1"},
      {"sql": "SELECT COUNT(*) >= 1 FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}}
    ]},
    {"name": "pipes-accept-and-ignore-both-modifiers", "steps": [
      {"sql": "CREATE TABLE pt (id INTEGER)"},
      {"sql": "CREATE STAGE ps"},
      {"sql": "CREATE PIPE pipe_a AS COPY INTO pt FROM @ps"},
      {"sql": "CREATE PIPE pipe_b AS COPY INTO pt FROM @ps"},
      {"sql": "SHOW PIPES", "expect": {"rowCount": 2}},
      {"sql": "SHOW PIPES LIMIT 1", "expect": {"rowCount": 2}},
      {"sql": "SHOW PIPES STARTS WITH 'ZZZ'", "expect": {"rowCount": 2}}
    ]},
    {"name": "streams-and-tasks-honour-limit", "steps": [
      {"sql": "CREATE TABLE m_a (id INTEGER)"},
      {"sql": "CREATE TABLE m_b (id INTEGER)"},
      {"sql": "CREATE STREAM s_a ON TABLE m_a"},
      {"sql": "CREATE STREAM s_b ON TABLE m_b"},
      {"sql": "SHOW STREAMS LIMIT 1", "expect": {"rowCount": 1}},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "S_A"}},
      {"sql": "SHOW STREAMS", "expect": {"rowCount": 2}},
      {"sql": "CREATE TASK tk_a SCHEDULE = '60 MINUTE' AS SELECT 1"},
      {"sql": "CREATE TASK tk_b SCHEDULE = '60 MINUTE' AS SELECT 2"},
      {"sql": "SHOW TASKS LIMIT 1", "expect": {"rowCount": 1}},
      {"sql": "SELECT \"name\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "TK_A"}}
    ]},
    {"name": "terse-views-synthesises-kind", "steps": [
      {"sql": "CREATE VIEW tv AS SELECT 1 AS c"},
      {"sql": "CREATE TABLE tmv_src (c INTEGER)"},
      {"sql": "CREATE MATERIALIZED VIEW tmv AS SELECT c FROM tmv_src"},
      {"sql": "SHOW TERSE VIEWS",
       "expect": {"columns": ["created_on", "name", "kind", "database_name", "schema_name"]}},
      {"sql": "SELECT \"name\", \"kind\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) ORDER BY \"name\" DESC",
       "expect": {"rows": [["TV", "VIEW"], ["TMV", "MATERIALIZED_VIEW"]], "ordered": true}}
    ]},
    {"name": "terse-schemas-and-databases-keep-the-five-column-shape", "steps": [
      {"sql": "SHOW TERSE SCHEMAS",
       "expect": {"columns": ["created_on", "name", "kind", "database_name", "schema_name"]}},
      {"sql": "SELECT COUNT_IF(\"kind\" IS NOT NULL AND \"kind\" != 'null') FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"value": "0"}},
      {"sql": "SHOW TERSE DATABASES",
       "expect": {"columns": ["created_on", "name", "kind", "database_name", "schema_name"]}},
      {"sql": "SELECT \"kind\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'TEST_DB'",
       "expect": {"value": "STANDARD"}}
    ]},
    {"name": "terse-streams-and-tasks-carry-a-sixth-column", "steps": [
      {"sql": "CREATE TABLE m_a (id INTEGER)"},
      {"sql": "CREATE STREAM s_a ON TABLE m_a"},
      {"sql": "SHOW TERSE STREAMS",
       "expect": {"columns": ["created_on", "name", "kind", "database_name", "schema_name", "tableOn"]}},
      {"sql": "SELECT \"kind\", \"tableOn\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) LIMIT 1",
       "expect": {"rows": [["DELTA", "M_A"]]}},
      {"sql": "CREATE TASK tk SCHEDULE = '60 MINUTE' AS SELECT 1"},
      {"sql": "SHOW TERSE TASKS",
       "expect": {"columns": ["created_on", "name", "kind", "database_name", "schema_name", "schedule"]}}
    ]},
    {"name": "terse-roles-and-users-have-their-own-subsets", "steps": [
      {"sql": "SHOW TERSE ROLES",
       "expect": {"columns": ["name", "is_default", "is_current", "is_inherited", "is_from_organization_user_group"]}},
      {"sql": "SHOW TERSE USERS",
       "expect": {"columns": ["name", "created_on", "display_name", "first_name", "last_name", "email", "comment", "has_password", "has_rsa_public_key", "type", "has_mfa", "has_pat", "has_workload_identity", "allowed_interfaces", "is_from_organization_user"]}}
    ]},
    {"name": "terse-is-inert-on-the-listings-that-do-not-trim", "steps": [
      {"sql": "CREATE TABLE m_a (id INTEGER)"},
      {"sql": "CREATE SEQUENCE q_a"},
      {"sql": "CREATE STAGE g_a"},
      {"sql": "CREATE FILE FORMAT ff_a TYPE = CSV"},
      {"sql": "CREATE TAG tg_a"},
      {"sql": "SHOW COLUMNS"},
      {"sql": "SET n_cols = (SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())))"},
      {"sql": "SHOW TERSE COLUMNS",
       "expect": {"columns": ["table_name", "schema_name", "column_name", "data_type", "null?", "default", "kind", "expression", "comment", "database_name", "autoincrement", "schema_evolution_record", "write_default"]}},
      {"sql": "SELECT COUNT(*) = $n_cols FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW TERSE SEQUENCES",
       "expect": {"rowCount": 1, "columns": ["name", "database_name", "schema_name", "next_value", "interval", "created_on", "owner", "comment", "owner_role_type", "ordered"]}},
      {"sql": "SHOW TERSE STAGES",
       "expect": {"rowCount": 1, "columns": ["created_on", "name", "database_name", "schema_name", "url", "has_credentials", "has_encryption_key", "owner", "comment", "region", "type", "cloud", "notification_channel", "storage_integration", "endpoint", "owner_role_type", "directory_enabled"]}},
      {"sql": "SHOW TERSE FILE FORMATS",
       "expect": {"rowCount": 1, "columns": ["created_on", "name", "database_name", "schema_name", "type", "owner", "comment", "format_options", "owner_role_type"]}},
      {"sql": "SHOW TERSE TAGS",
       "expect": {"rowCount": 1, "columns": ["created_on", "name", "database_name", "schema_name", "owner", "comment", "allowed_values", "owner_role_type", "propagate", "on_conflict", "multi_value"]}},
      {"sql": "SHOW WAREHOUSES"},
      {"sql": "SET n_wh = (SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())))"},
      {"sql": "SHOW TERSE WAREHOUSES",
       "expect": {"columns": ["name", "state", "type", "size", "min_cluster_count", "max_cluster_count", "started_clusters", "running", "queued", "is_default", "is_current", "auto_suspend", "auto_resume", "available", "provisioning", "quiescing", "other", "created_on", "resumed_on", "updated_on", "owner", "comment", "enable_query_acceleration", "query_acceleration_max_scale_factor", "resource_monitor", "actives", "pendings", "failed", "suspended", "uuid", "scaling_policy", "owner_role_type", "resource_constraint", "generation", "query_throughput_multiplier", "max_query_performance_level", "disabled_reasons", "tables"]}},
      {"sql": "SELECT COUNT(*) = $n_wh FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW TERSE PIPES",
       "expect": {"rowCount": 0, "columns": ["created_on", "name", "database_name", "schema_name", "definition", "owner", "notification_channel", "comment", "integration", "pattern", "error_integration", "owner_role_type", "invalid_reason", "kind", "is_snowflake_managed"]}},
      {"sql": "SHOW TERSE MASKING POLICIES",
       "expect": {"rowCount": 0, "columns": ["created_on", "name", "database_name", "schema_name", "kind", "owner", "comment", "owner_role_type", "options"]}},
      {"sql": "SHOW TERSE ROW ACCESS POLICIES",
       "expect": {"rowCount": 0, "columns": ["created_on", "name", "database_name", "schema_name", "kind", "owner", "comment", "owner_role_type", "options"]}},
      {"sql": "SHOW TERSE MATERIALIZED VIEWS",
       "expect": {"rowCount": 0, "columns": ["created_on", "name", "reserved", "database_name", "schema_name", "cluster_by", "rows", "bytes", "source_database_name", "source_schema_name", "source_table_name", "refreshed_on", "compacted_on", "owner", "invalid", "invalid_reason", "behind_by", "comment", "text", "is_secure", "automatic_clustering", "owner_role_type"]}},
      {"sql": "SHOW TERSE DYNAMIC TABLES",
       "expect": {"rowCount": 0, "columns": ["created_on", "name", "database_name", "schema_name", "cluster_by", "rows", "bytes", "owner", "target_lag", "refresh_mode", "refresh_mode_reason", "warehouse", "comment", "text", "automatic_clustering", "scheduling_state", "last_suspended_on", "is_clone", "is_replica", "is_iceberg", "data_timestamp", "owner_role_type", "execute_as_user", "secondary_role_names", "insert_only_inputs", "immutable_where", "initialization_warehouse", "backfill_from", "scheduler", "frozen_where", "configured_refresh_mode"]}},
      {"sql": "SHOW TERSE PRIMARY KEYS",
       "expect": {"rowCount": 0, "columns": ["created_on", "database_name", "schema_name", "table_name", "column_name", "key_sequence", "constraint_name", "rely", "comment"]}},
      {"sql": "SHOW FUNCTIONS"},
      {"sql": "SET n_fn = (SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())))"},
      {"sql": "SHOW TERSE FUNCTIONS"},
      {"sql": "SELECT COUNT(*) = $n_fn FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}},
      {"sql": "SHOW PROCEDURES"},
      {"sql": "SET n_pr = (SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())))"},
      {"sql": "SHOW TERSE PROCEDURES",
       "expect": {"columns": ["created_on", "name", "schema_name", "is_builtin", "is_aggregate", "is_ansi", "min_num_arguments", "max_num_arguments", "arguments", "description", "catalog_name", "is_table_function", "valid_for_clustering", "is_secure", "secrets", "external_access_integrations"]}},
      {"sql": "SELECT COUNT(*) = $n_pr FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "true"}}
    ]}
  ]
}
