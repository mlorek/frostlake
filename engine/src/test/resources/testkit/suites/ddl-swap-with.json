{
  "suite": "ddl-swap-with",
  "description": "ALTER TABLE a SWAP WITH b exchanges two tables' row storage. Converted 1:1 from ddl/SwapWithTest (now retired).",
  "tags": ["ddl", "converted"],
  "tests": [
    {"name": "swap-exchanges-data", "steps": [
      {"sql": "CREATE TABLE blue (id INTEGER)"},
      {"sql": "CREATE TABLE green (id INTEGER)"},
      {"sql": "INSERT INTO blue VALUES (1), (2)"},
      {"sql": "INSERT INTO green VALUES (99)"},
      {"sql": "ALTER TABLE blue SWAP WITH green"},
      {"sql": "SELECT COUNT(*) FROM blue", "expect": {"value": "1"}},
      {"sql": "SELECT COUNT(*) FROM green", "expect": {"value": "2"}},
      {"sql": "SELECT id FROM blue", "expect": {"value": "99"}}
    ]}
  ]
}
