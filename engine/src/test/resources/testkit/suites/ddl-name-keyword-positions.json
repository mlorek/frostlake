{
  "suite": "ddl-name-keyword-positions",
  "description": "Which keywords may NAME something, position by position (live-measured): CASE/CAST/CONSTRAINT/DEFAULT/WHEN name tables, views, schemas, RENAME targets and CTEs and qualify a star, but are never a column REFERENCE; the eight join words are ordinary names everywhere EXCEPT a bare FROM (where the join grammar owns them - qualified they parse and miss the schema); CONSTRAINT alone is readable but not definable as a column; the agreeing words keep agreeing; reserved words stay refused everywhere. Converted 1:1 from ddl/NameKeywordPositionTest (now retired).",
  "tags": ["ddl", "converted"],
  "tests": [
    {"name": "the-five-words-name-every-object", "steps": [
      {"sql": "CREATE TABLE CASE (a INT)"},
      {"sql": "ALTER TABLE CASE RENAME TO r_CASE"},
      {"sql": "ALTER TABLE r_CASE RENAME TO CASE"},
      {"sql": "CREATE VIEW v_CASE AS SELECT a FROM CASE"},
      {"sql": "DROP VIEW v_CASE"},
      {"sql": "DROP TABLE CASE"},
      {"sql": "CREATE TABLE CAST (a INT)"},
      {"sql": "ALTER TABLE CAST RENAME TO r_CAST"},
      {"sql": "ALTER TABLE r_CAST RENAME TO CAST"},
      {"sql": "CREATE VIEW v_CAST AS SELECT a FROM CAST"},
      {"sql": "DROP VIEW v_CAST"},
      {"sql": "DROP TABLE CAST"},
      {"sql": "CREATE TABLE CONSTRAINT (a INT)"},
      {"sql": "ALTER TABLE CONSTRAINT RENAME TO r_CONSTRAINT"},
      {"sql": "ALTER TABLE r_CONSTRAINT RENAME TO CONSTRAINT"},
      {"sql": "CREATE VIEW v_CONSTRAINT AS SELECT a FROM CONSTRAINT"},
      {"sql": "DROP VIEW v_CONSTRAINT"},
      {"sql": "DROP TABLE CONSTRAINT"},
      {"sql": "CREATE TABLE DEFAULT (a INT)"},
      {"sql": "ALTER TABLE DEFAULT RENAME TO r_DEFAULT"},
      {"sql": "ALTER TABLE r_DEFAULT RENAME TO DEFAULT"},
      {"sql": "CREATE VIEW v_DEFAULT AS SELECT a FROM DEFAULT"},
      {"sql": "DROP VIEW v_DEFAULT"},
      {"sql": "DROP TABLE DEFAULT"},
      {"sql": "CREATE TABLE WHEN (a INT)"},
      {"sql": "ALTER TABLE WHEN RENAME TO r_WHEN"},
      {"sql": "ALTER TABLE r_WHEN RENAME TO WHEN"},
      {"sql": "CREATE VIEW v_WHEN AS SELECT a FROM WHEN"},
      {"sql": "DROP VIEW v_WHEN"},
      {"sql": "DROP TABLE WHEN"}
    ]},
    {"name": "the-five-words-name-a-cte", "steps": [
      {"sql": "WITH CASE AS (SELECT 7 AS x) SELECT x FROM CASE", "expect": {"value": "7"}},
      {"sql": "WITH CAST AS (SELECT 7 AS x) SELECT x FROM CAST", "expect": {"value": "7"}},
      {"sql": "WITH CONSTRAINT AS (SELECT 7 AS x) SELECT x FROM CONSTRAINT", "expect": {"value": "7"}},
      {"sql": "WITH DEFAULT AS (SELECT 7 AS x) SELECT x FROM DEFAULT", "expect": {"value": "7"}},
      {"sql": "WITH WHEN AS (SELECT 7 AS x) SELECT x FROM WHEN", "expect": {"value": "7"}}
    ]},
    {"name": "the-five-words-name-a-schema", "steps": [
      {"sql": "CREATE SCHEMA IF NOT EXISTS s_CASE"},
      {"sql": "CREATE SCHEMA IF NOT EXISTS s_CAST"},
      {"sql": "CREATE SCHEMA IF NOT EXISTS s_CONSTRAINT"},
      {"sql": "CREATE SCHEMA IF NOT EXISTS s_DEFAULT"},
      {"sql": "CREATE SCHEMA IF NOT EXISTS s_WHEN"},
      {"sql": "USE SCHEMA test_schema"}
    ]},
    {"name": "the-five-words-are-no-column-reference", "steps": [
      {"sql": "CREATE TABLE kw (a INT)"},
      {"sql": "INSERT INTO kw VALUES (1)"},
      {"sql": "CREATE TABLE defs (CASE INT, CAST INT, DEFAULT INT, WHEN INT)"},
      {"sql": "SELECT CASE FROM defs", "expect": {"error": {}}},
      {"sql": "SELECT a FROM kw WHERE CASE = 1", "expect": {"error": {}}},
      {"sql": "SELECT CAST FROM defs", "expect": {"error": {}}},
      {"sql": "SELECT a FROM kw WHERE CAST = 1", "expect": {"error": {}}},
      {"sql": "SELECT CONSTRAINT FROM defs", "expect": {"error": {}}},
      {"sql": "SELECT a FROM kw WHERE CONSTRAINT = 1", "expect": {"error": {}}},
      {"sql": "SELECT DEFAULT FROM defs", "expect": {"error": {}}},
      {"sql": "SELECT a FROM kw WHERE DEFAULT = 1", "expect": {"error": {}}},
      {"sql": "SELECT WHEN FROM defs", "expect": {"error": {}}},
      {"sql": "SELECT a FROM kw WHERE WHEN = 1", "expect": {"error": {}}}
    ]},
    {"name": "the-five-words-qualify-a-star", "steps": [
      {"sql": "CREATE OR REPLACE TABLE CASE (a INT)"},
      {"sql": "INSERT INTO CASE VALUES (3)"},
      {"sql": "SELECT CASE.* FROM CASE", "expect": {"value": "3"}},
      {"sql": "DROP TABLE CASE"},
      {"sql": "CREATE OR REPLACE TABLE CAST (a INT)"},
      {"sql": "INSERT INTO CAST VALUES (3)"},
      {"sql": "SELECT CAST.* FROM CAST", "expect": {"value": "3"}},
      {"sql": "DROP TABLE CAST"},
      {"sql": "CREATE OR REPLACE TABLE CONSTRAINT (a INT)"},
      {"sql": "INSERT INTO CONSTRAINT VALUES (3)"},
      {"sql": "SELECT CONSTRAINT.* FROM CONSTRAINT", "expect": {"value": "3"}},
      {"sql": "DROP TABLE CONSTRAINT"},
      {"sql": "CREATE OR REPLACE TABLE DEFAULT (a INT)"},
      {"sql": "INSERT INTO DEFAULT VALUES (3)"},
      {"sql": "SELECT DEFAULT.* FROM DEFAULT", "expect": {"value": "3"}},
      {"sql": "DROP TABLE DEFAULT"},
      {"sql": "CREATE OR REPLACE TABLE WHEN (a INT)"},
      {"sql": "INSERT INTO WHEN VALUES (3)"},
      {"sql": "SELECT WHEN.* FROM WHEN", "expect": {"value": "3"}},
      {"sql": "DROP TABLE WHEN"}
    ]},
    {"name": "a-join-word-is-no-bare-table-reference", "steps": [
      {"sql": "SELECT a FROM ASOF", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM FULL", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM LATERAL", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM LEFT", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM MATCH_CONDITION", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM NATURAL", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM RIGHT", "expect": {"error": {"messageContains": "syntax error"}}},
      {"sql": "SELECT a FROM USING", "expect": {"error": {"messageContains": "syntax error"}}}
    ]},
    {"name": "a-join-word-qualifies-a-name", "steps": [
      {"sql": "SELECT a FROM ASOF.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM FULL.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM LATERAL.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM LEFT.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM MATCH_CONDITION.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM NATURAL.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM RIGHT.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}},
      {"sql": "SELECT a FROM USING.kw", "expect": {"error": {"messageContains": "does not exist or not authorized."}}}
    ]},
    {"name": "a-join-word-names-a-table-and-a-cte", "steps": [
      {"sql": "CREATE TABLE ASOF (a INT)"},
      {"sql": "INSERT INTO ASOF VALUES (1)"},
      {"sql": "DROP TABLE ASOF"},
      {"sql": "WITH ASOF AS (SELECT 5 AS x) SELECT x FROM \"ASOF\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE FULL (a INT)"},
      {"sql": "INSERT INTO FULL VALUES (1)"},
      {"sql": "DROP TABLE FULL"},
      {"sql": "WITH FULL AS (SELECT 5 AS x) SELECT x FROM \"FULL\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE LATERAL (a INT)"},
      {"sql": "INSERT INTO LATERAL VALUES (1)"},
      {"sql": "DROP TABLE LATERAL"},
      {"sql": "WITH LATERAL AS (SELECT 5 AS x) SELECT x FROM \"LATERAL\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE LEFT (a INT)"},
      {"sql": "INSERT INTO LEFT VALUES (1)"},
      {"sql": "DROP TABLE LEFT"},
      {"sql": "WITH LEFT AS (SELECT 5 AS x) SELECT x FROM \"LEFT\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE MATCH_CONDITION (a INT)"},
      {"sql": "INSERT INTO MATCH_CONDITION VALUES (1)"},
      {"sql": "DROP TABLE MATCH_CONDITION"},
      {"sql": "WITH MATCH_CONDITION AS (SELECT 5 AS x) SELECT x FROM \"MATCH_CONDITION\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE NATURAL (a INT)"},
      {"sql": "INSERT INTO NATURAL VALUES (1)"},
      {"sql": "DROP TABLE NATURAL"},
      {"sql": "WITH NATURAL AS (SELECT 5 AS x) SELECT x FROM \"NATURAL\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE RIGHT (a INT)"},
      {"sql": "INSERT INTO RIGHT VALUES (1)"},
      {"sql": "DROP TABLE RIGHT"},
      {"sql": "WITH RIGHT AS (SELECT 5 AS x) SELECT x FROM \"RIGHT\"", "expect": {"value": "5"}},
      {"sql": "CREATE TABLE USING (a INT)"},
      {"sql": "INSERT INTO USING VALUES (1)"},
      {"sql": "DROP TABLE USING"},
      {"sql": "WITH USING AS (SELECT 5 AS x) SELECT x FROM \"USING\"", "expect": {"value": "5"}}
    ]},
    {"name": "constraint-is-readable-but-not-definable", "steps": [
      {"sql": "CREATE TABLE kw (a INT)"},
      {"sql": "INSERT INTO kw VALUES (1)"},
      {"sql": "SELECT kw.constraint FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.CONSTRAINT'"}}},
      {"sql": "INSERT INTO kw (constraint) VALUES (1)", "expect": {"error": {"messageContains": "invalid identifier 'CONSTRAINT'"}}},
      {"sql": "UPDATE kw SET constraint = 1", "expect": {"error": {"messageContains": "invalid identifier 'CONSTRAINT'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd (CONSTRAINT INT)", "expect": {"error": {"messageContains": "syntax error line 1 at position 42 unexpected ')'"}}}
    ]},
    {"name": "every-other-word-agrees-in-both-positions", "steps": [
      {"sql": "CREATE TABLE kw (a INT)"},
      {"sql": "INSERT INTO kw VALUES (1)"},
      {"sql": "CREATE OR REPLACE TABLE cd_CASE (CASE INT)"},
      {"sql": "SELECT kw.CASE FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.CASE'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_CAST (CAST INT)"},
      {"sql": "SELECT kw.CAST FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.CAST'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_DEFAULT (DEFAULT INT)"},
      {"sql": "SELECT kw.DEFAULT FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.DEFAULT'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_WHEN (WHEN INT)"},
      {"sql": "SELECT kw.WHEN FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.WHEN'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_INNER (INNER INT)"},
      {"sql": "SELECT kw.INNER FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.INNER'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_JOIN (JOIN INT)"},
      {"sql": "SELECT kw.JOIN FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.JOIN'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_LEFT (LEFT INT)"},
      {"sql": "SELECT kw.LEFT FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.LEFT'"}}},
      {"sql": "CREATE OR REPLACE TABLE cd_CROSS (CROSS INT)"},
      {"sql": "SELECT kw.CROSS FROM kw", "expect": {"error": {"messageContains": "invalid identifier 'KW.CROSS'"}}}
    ]},
    {"name": "a-reserved-word-is-still-no-name", "steps": [
      {"sql": "CREATE TABLE kw (a INT)"},
      {"sql": "CREATE TABLE VALUES (a INT)", "expect": {"error": {}}},
      {"sql": "CREATE VIEW VALUES AS SELECT 1 AS x", "expect": {"error": {}}},
      {"sql": "WITH VALUES AS (SELECT 1 AS x) SELECT x FROM kw", "expect": {"error": {}}},
      {"sql": "SELECT a FROM VALUES", "expect": {"error": {}}},
      {"sql": "CREATE TABLE ORDER (a INT)", "expect": {"error": {}}},
      {"sql": "CREATE VIEW ORDER AS SELECT 1 AS x", "expect": {"error": {}}},
      {"sql": "WITH ORDER AS (SELECT 1 AS x) SELECT x FROM kw", "expect": {"error": {}}},
      {"sql": "SELECT a FROM ORDER", "expect": {"error": {}}}
    ]}
  ]
}
