{
  "suite": "functions-try-cast",
  "description": "TRY_CAST(expr AS type) converts like CAST but answers NULL for a value that cannot be converted rather than raising. It converts only FROM a string - live-verified, a numeric source fails \"Function TRY_CAST cannot be used with arguments of types NUMBER(3,0) and VARCHAR(...)\" - and a bare NUMBER target follows the NUMBER(38,0) default, rounding to a whole number. TRY_CAST is pure GRAMMAR, not a function: the two-argument and one-argument call shapes are both syntax errors. The name stays an ordinary IDENTIFIER in name positions - as an alias, a column name, a table name, a SET target and an INSERT column list - while in EXPRESSION position it always begins the cast construct, so a bare reference is refused as a syntax error in every expression clause; qualifying or quoting the column is the live-legal escape. Converted 1:1 from functions/TryCastTest (now retired); the scaled results are stringified so their trailing digits are part of the assertion.",
  "tags": ["functions", "converted"],
  "tests": [
    {"name": "it-converts-valid-values", "steps": [
      {"sql": "SELECT TRY_CAST('123' AS INTEGER)", "expect": {"value": "123"}},
      {"sql": "SELECT TRY_CAST(123 AS VARCHAR)", "expect": {"error": {}}},
      {"sql": "SELECT TRY_CAST('1.5' AS FLOAT)", "expect": {"value": "1.5"}}
    ]},
    {"name": "it-returns-null-on-failure", "steps": [
      {"sql": "SELECT TRY_CAST('abc' AS INTEGER)", "expect": {"rows": [[null]]}},
      {"sql": "SELECT TRY_CAST('not_a_number' AS NUMBER)", "expect": {"rows": [[null]]}}
    ]},
    {"name": "a-null-input-stays-null", "steps": [
      {"sql": "SELECT TRY_CAST(NULL AS INTEGER)", "expect": {"rows": [[null]]}}
    ]},
    {"name": "a-bare-number-target-rounds-to-scale-zero", "steps": [
      {"sql": "SELECT TRY_CAST('405.958' AS NUMBER)", "expect": {"value": "406"}},
      {"sql": "SELECT '<' || TRY_CAST('405.958' AS NUMBER(10,2)) || '>'", "expect": {"value": "<405.96>"}}
    ]},
    {"name": "it-is-usable-in-a-projection", "steps": [
      {"sql": "SELECT TRY_CAST(SPLIT_PART('sev:42', ':', 2) AS INTEGER)", "expect": {"value": "42"}}
    ]},
    {"name": "the-function-call-shapes-are-syntax-errors", "steps": [
      {"sql": "SELECT TRY_CAST('1.5', 'NUMBER(10,2)')", "expect": {"error": {}}},
      {"sql": "SELECT TRY_CAST('1.5')", "expect": {"error": {}}}
    ]},
    {"name": "try-cast-remains-an-identifier-in-name-positions", "steps": [
      {"sql": "SELECT 1 AS try_cast", "expect": {"value": "1"}},
      {"sql": "SELECT 1 try_cast", "expect": {"value": "1"}},
      {"sql": "CREATE TABLE try_cast_names (try_cast INT)"},
      {"sql": "CREATE TABLE try_cast (a INT)"},
      {"sql": "INSERT INTO try_cast VALUES (7)"},
      {"sql": "SELECT a FROM try_cast", "expect": {"value": "7"}}
    ]},
    {"name": "the-bare-expression-position-is-the-construct", "steps": [
      {"sql": "CREATE TABLE try_cast_expr (id INTEGER, try_cast INTEGER)"},
      {"sql": "INSERT INTO try_cast_expr VALUES (1, 7)"},
      {"sql": "SELECT try_cast FROM try_cast_expr", "expect": {"error": {"messageContains": "syntax"}}},
      {"sql": "SELECT TRY_CAST", "expect": {"error": {"messageContains": "syntax"}}},
      {"sql": "SELECT id FROM try_cast_expr WHERE try_cast = 7", "expect": {"error": {"messageContains": "syntax"}}},
      {"sql": "SELECT COUNT(*) FROM try_cast_expr GROUP BY try_cast", "expect": {"error": {"messageContains": "syntax"}}},
      {"sql": "SELECT id FROM try_cast_expr ORDER BY try_cast", "expect": {"error": {"messageContains": "syntax"}}},
      {"sql": "SELECT try_cast + 1 FROM try_cast_expr", "expect": {"error": {"messageContains": "syntax"}}}
    ]},
    {"name": "qualified-and-quoted-references-reach-the-column", "steps": [
      {"sql": "CREATE TABLE try_cast_q (id INTEGER, try_cast INTEGER)"},
      {"sql": "INSERT INTO try_cast_q VALUES (1, 7)"},
      {"sql": "SELECT try_cast_q.try_cast FROM try_cast_q", "expect": {"value": "7"}},
      {"sql": "SELECT x.try_cast FROM try_cast_q x", "expect": {"value": "7"}},
      {"sql": "SELECT \"TRY_CAST\" FROM try_cast_q", "expect": {"value": "7"}},
      {"sql": "UPDATE try_cast_q SET try_cast = 8"},
      {"sql": "SELECT x.try_cast FROM try_cast_q x", "expect": {"value": "8"}},
      {"sql": "INSERT INTO try_cast_q (id, try_cast) VALUES (2, 9)"},
      {"sql": "SELECT COUNT(*) FROM try_cast_q", "expect": {"value": "2"}}
    ]}
  ]
}
