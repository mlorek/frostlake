{
  "suite": "dml-insert",
  "description": "INSERT forms and column-count validation, converted 1:1 from dml/InsertTest.java and dml/InsertColumnCountTest.java (both now retired).",
  "tags": ["dml", "converted"],
  "tests": [
    {
      "name": "basic-insert",
      "steps": [
        {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER)"},
        {"sql": "INSERT INTO users VALUES (1, 'Alice', 30)"},
        {"sql": "SELECT * FROM users", "expect": {"rowCount": 1}}
      ]
    },
    {
      "name": "bulk-insert",
      "steps": [
        {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER)"},
        {"sql": "INSERT INTO users VALUES (1, 'Alice', 30), (2, 'Bob', 25), (3, 'Charlie', 35)"},
        {"sql": "SELECT * FROM users", "expect": {"rowCount": 3}}
      ]
    },
    {
      "name": "insert-with-column-list",
      "steps": [
        {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER, city VARCHAR)"},
        {"sql": "INSERT INTO users (id, name, age) VALUES (1, 'Alice', 30)"},
        {"sql": "SELECT * FROM users", "expect": {"rows": [["1", "Alice", "30", null]]}}
      ]
    },
    {
      "name": "insert-with-different-types",
      "steps": [
        {"sql": "CREATE TABLE test_types (int_col INTEGER, str_col VARCHAR, bool_col BOOLEAN, float_col FLOAT)"},
        {"sql": "INSERT INTO test_types VALUES (42, 'hello', true, 3.14)"},
        {"sql": "SELECT * FROM test_types", "expect": {"rows": [["42", "hello", "true", "3.14"]]}}
      ]
    },
    {
      "name": "insert-with-nulls",
      "steps": [
        {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER)"},
        {"sql": "INSERT INTO users VALUES (1, 'Alice', null)"},
        {"sql": "SELECT * FROM users", "expect": {"rows": [["1", "Alice", null]]}}
      ]
    },
    {
      "name": "insert-multiple-rows",
      "steps": [
        {"sql": "CREATE TABLE products (id INTEGER, name VARCHAR, price INTEGER)"},
        {"sql": "INSERT INTO products VALUES (1, 'Widget', 100)"},
        {"sql": "INSERT INTO products VALUES (2, 'Gadget', 200)"},
        {"sql": "INSERT INTO products VALUES (3, 'Doohickey', 150)"},
        {"sql": "SELECT * FROM products", "expect": {"rowCount": 3}}
      ]
    },
    {
      "name": "insert-and-query",
      "steps": [
        {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR, age INTEGER)"},
        {"sql": "INSERT INTO users VALUES (1, 'Alice', 30)"},
        {"sql": "INSERT INTO users VALUES (2, 'Bob', 25)"},
        {"sql": "SELECT * FROM users WHERE age > 28", "expect": {"rows": [["1", "Alice", "30"]]}}
      ]
    },
    {
      "name": "too-few-values-throws-cleanly",
      "steps": [
        {"sql": "CREATE TABLE t (a INTEGER, b INTEGER)"},
        {"sql": "INSERT INTO t (a, b) VALUES (1)", "expect": {"error": {}}}
      ]
    },
    {
      "name": "too-many-values-throws-cleanly",
      "steps": [
        {"sql": "CREATE TABLE t (a INTEGER, b INTEGER)"},
        {"sql": "INSERT INTO t (a) VALUES (1, 2)", "expect": {"error": {}}}
      ]
    }
  ]
}
