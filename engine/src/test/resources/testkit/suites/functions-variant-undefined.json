{
  "suite": "functions-variant-undefined",
  "description": "The VARIANT undefined element - the third null of the semi-structured layer. Every assertion was verified against a real Snowflake account. Throughout, ac is ARRAY_CONSTRUCT(1, NULL, 2) (which renders [1,undefined,2]) and pj is PARSE_JSON('[1,null,2]') (which keeps [1,null,2]); each behaviour is asserted for BOTH so the two nulls stay distinguishable. Every SQL NULL entering an array becomes an undefined, PARSE_JSON accepts the bare token OUTSIDE string values, undefined lives only in an ARRAY (an object downgrades it to a JSON null and a whole-value undefined is SQL NULL), and it never escapes as a value: extracting one is SQL NULL where extracting a JSON null is still a value. It is COUNTED by ARRAY_SIZE, SKIPPED by FLATTEN, removed by ARRAY_COMPACT alongside the JSON null, rendered as the empty string by ARRAY_TO_STRING, ignored by ARRAY_MIN/MAX, matched only by its own kind of null in the containment and set functions, and moved to the END by ARRAY_DISTINCT but only when that call actually deduplicates. Converted 1:1 from functions/VariantUndefinedTest (now retired); where the Java compared a String.valueOf render to the text 'null' - which a Java null would also satisfy - the converted test pins TYPEOF and IS NULL instead, both measured (TYPEOF is NULL_VALUE, IS NULL is FALSE).",
  "tags": ["functions", "converted"],
  "tests": [
    {"name": "every-sql-null-entering-an-array-becomes-undefined",
     "steps": [
      {"sql": "SELECT ARRAY_CONSTRUCT(1, NULL, 2)", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT [1, NULL, 2]", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT ARRAY_APPEND(ARRAY_CONSTRUCT(1), NULL)", "expect": {"value": "[1,undefined]"}},
      {"sql": "SELECT ARRAY_PREPEND(ARRAY_CONSTRUCT(1), NULL)", "expect": {"value": "[undefined,1]"}},
      {"sql": "SELECT ARRAY_INSERT(ARRAY_CONSTRUCT(1), 4, 9)", "expect": {"value": "[1,undefined,undefined,undefined,9]"}},
      {"sql": "SELECT ARRAY_REPEAT(NULL, 3)", "expect": {"value": "[undefined,undefined,undefined]"}},
      {"sql": "SELECT TRANSFORM(ARRAY_CONSTRUCT(1, 2), x -> NULL)", "expect": {"value": "[undefined,undefined]"}},
      {"sql": "SELECT [** NULL]", "expect": {"value": "[undefined]"}},
      {"sql": "SELECT ARRAY_CONSTRUCT(NULL::VARIANT)", "expect": {"value": "[undefined]"}}
    ]},
    {"name": "parse-json-accepts-the-bare-undefined-token", "steps": [
      {"sql": "SELECT PARSE_JSON('[undefined]')", "expect": {"value": "[undefined]"}},
      {"sql": "SELECT TRY_PARSE_JSON('[undefined]')", "expect": {"value": "[undefined]"}},
      {"sql": "SELECT CHECK_JSON('[1,undefined,2]')", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_CONSTRUCT(NULL) = PARSE_JSON('[undefined]')", "expect": {"value": "true"}}
    ]},
    {"name": "a-genuine-undefined-string-stays-a-string", "steps": [
      {"sql": "SELECT PARSE_JSON('[\"undefined\"]')", "expect": {"value": "[\"undefined\"]"}},
      {"sql": "SELECT TYPEOF(GET(PARSE_JSON('[\"undefined\"]'), 0))", "expect": {"value": "VARCHAR"}},
      {"sql": "SELECT PARSE_JSON('{\"m\":\"is undefined here\"}'):m::VARCHAR", "expect": {"value": "is undefined here"}}
    ]},
    {"name": "these-are-not-producers", "steps": [
      {"sql": "SELECT PARSE_JSON('[1,null,2]')", "expect": {"value": "[1,null,2]"}},
      {"sql": "SELECT ARRAY_CONSTRUCT(PARSE_JSON('null'))", "expect": {"value": "[null]"}},
      {"sql": "SELECT OBJECT_CONSTRUCT_KEEP_NULL('k', NULL)", "expect": {"value": "{\"k\":null}"}},
      {"sql": "SELECT OBJECT_CONSTRUCT('k', NULL)", "expect": {"value": "{}"}},
      {"sql": "SELECT TO_ARRAY(NULL)", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_AGG(v) FROM (SELECT 1 v UNION ALL SELECT NULL UNION ALL SELECT 2)", "expect": {"value": "[1,2]"}}
    ]},
    {"name": "undefined-lives-only-in-an-array-never-in-an-object", "steps": [
      {"sql": "SELECT PARSE_JSON('{\"a\":undefined}')", "expect": {"value": "{\"a\":null}"}},
      {"sql": "SELECT TO_JSON(PARSE_JSON('{\"a\":undefined,\"b\":1}'))", "expect": {"value": "{\"a\":null,\"b\":1}"}},
      {"sql": "SELECT ARRAY_CONSTRUCT(OBJECT_CONSTRUCT_KEEP_NULL('k', NULL), NULL)", "expect": {"value": "[{\"k\":null},undefined]"}},
      {"sql": "SELECT PARSE_JSON('undefined')", "expect": {"rows": [[null]]}},
      {"sql": "SELECT TYPEOF(PARSE_JSON('undefined'))", "expect": {"rows": [[null]]}}
    ]},
    {"name": "extracting-an-undefined-yields-sql-null-while-a-json-null-stays-a-value", "steps": [
      {"sql": "SELECT TYPEOF(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT GET(ARRAY_CONSTRUCT(1, NULL, 2), 1) IS NULL", "expect": {"value": "true"}},
      {"sql": "SELECT IS_NULL_VALUE(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT TO_JSON(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT COALESCE(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1), 9)", "expect": {"value": "9"}},
      {"sql": "SELECT TYPEOF(GET(PARSE_JSON('[1,null,2]'), 1))", "expect": {"value": "NULL_VALUE"}},
      {"sql": "SELECT GET(PARSE_JSON('[1,null,2]'), 1) IS NULL", "expect": {"value": "false"}},
      {"sql": "SELECT IS_NULL_VALUE(GET(PARSE_JSON('[1,null,2]'), 1))", "expect": {"value": "true"}},
      {"sql": "SELECT TO_JSON(GET(PARSE_JSON('[1,null,2]'), 1))", "expect": {"value": "null"}},
      {"sql": "SELECT TYPEOF(COALESCE(GET(PARSE_JSON('[1,null,2]'), 1), 9))", "expect": {"value": "NULL_VALUE"}},
      {"sql": "SELECT COALESCE(GET(PARSE_JSON('[1,null,2]'), 1), 9) IS NULL", "expect": {"value": "false"}}
    ]},
    {"name": "bracket-and-path-access-agree-with-get", "steps": [
      {"sql": "SELECT (ARRAY_CONSTRUCT(1, NULL, 2))[1] IS NULL", "expect": {"value": "true"}},
      {"sql": "SELECT GET_PATH(ARRAY_CONSTRUCT(1, NULL, 2), '[1]')", "expect": {"rows": [[null]]}},
      {"sql": "SELECT EQUAL_NULL(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1), NULL)", "expect": {"value": "true"}},
      {"sql": "SELECT STRIP_NULL_VALUE(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT (PARSE_JSON('[1,null,2]'))[1] IS NULL", "expect": {"value": "false"}},
      {"sql": "SELECT EQUAL_NULL(GET(PARSE_JSON('[1,null,2]'), 1), NULL)", "expect": {"value": "false"}}
    ]},
    {"name": "a-nested-undefined-extracts-as-sql-null-too", "steps": [
      {"sql": "SELECT ARRAY_CONSTRUCT(ARRAY_CONSTRUCT(1, NULL), 2)", "expect": {"value": "[[1,undefined],2]"}},
      {"sql": "SELECT OBJECT_CONSTRUCT('a', ARRAY_CONSTRUCT(NULL))", "expect": {"value": "{\"a\":[undefined]}"}},
      {"sql": "SELECT PARSE_JSON('{\"k\":[undefined]}'):k", "expect": {"value": "[undefined]"}},
      {"sql": "SELECT GET(GET(ARRAY_CONSTRUCT(ARRAY_CONSTRUCT(1, NULL), 2), 0), 1) IS NULL", "expect": {"value": "true"}}
    ]},
    {"name": "rendering-and-size-keep-the-element", "steps": [
      {"sql": "SELECT TO_JSON(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT ARRAY_CONSTRUCT(1, NULL, 2)::VARCHAR", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT TO_VARCHAR(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT ARRAY_SIZE(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "3"}},
      {"sql": "SELECT ARRAY_SIZE(PARSE_JSON('[1,null,2]'))", "expect": {"value": "3"}},
      {"sql": "SELECT TYPEOF(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "ARRAY"}}
    ]},
    {"name": "undefined-is-not-equal-to-a-json-null", "steps": [
      {"sql": "SELECT ARRAY_CONSTRUCT(1, NULL, 2) = ARRAY_CONSTRUCT(1, NULL, 2)", "expect": {"value": "true"}},
      {"sql": "SELECT ARRAY_CONSTRUCT(1, NULL, 2) = PARSE_JSON('[1,null,2]')", "expect": {"value": "false"}}
    ]},
    {"name": "stored-arrays-round-trip-and-stay-distinct", "steps": [
      {"sql": "CREATE TABLE u_round (id INT, a ARRAY, v VARIANT)"},
      {"sql": "INSERT INTO u_round SELECT 1, ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(1, NULL, 2)"},
      {"sql": "INSERT INTO u_round SELECT 2, PARSE_JSON('[1,null,2]'), PARSE_JSON('[1,null,2]')"},
      {"sql": "INSERT INTO u_round SELECT 3, ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(1, NULL, 2)"},
      {"sql": "SELECT a FROM u_round WHERE id = 1", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT a FROM u_round WHERE id = 2", "expect": {"value": "[1,null,2]"}},
      {"sql": "SELECT v FROM u_round WHERE id = 1", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT TYPEOF(GET(a, 1)) FROM u_round WHERE id = 1", "expect": {"rows": [[null]]}},
      {"sql": "SELECT TYPEOF(GET(a, 1)) FROM u_round WHERE id = 2", "expect": {"value": "NULL_VALUE"}},
      {"sql": "SELECT COUNT(*) FROM (SELECT a FROM u_round GROUP BY a)", "expect": {"value": "2"}},
      {"sql": "SELECT COUNT(*) FROM u_round WHERE a = ARRAY_CONSTRUCT(1, NULL, 2)", "expect": {"value": "2"}}
    ]},
    {"name": "array-compact-removes-both-nulls", "steps": [
      {"sql": "SELECT ARRAY_COMPACT(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "[1,2]"}},
      {"sql": "SELECT ARRAY_COMPACT(PARSE_JSON('[1,null,2]'))", "expect": {"value": "[1,2]"}},
      {"sql": "SELECT ARRAY_COMPACT(ARRAY_CAT(ARRAY_CONSTRUCT(1, NULL, 2), PARSE_JSON('[1,null,2]')))", "expect": {"value": "[1,2,1,2]"}},
      {"sql": "SELECT ARRAY_COMPACT(ARRAY_CONSTRUCT(NULL))", "expect": {"value": "[]"}},
      {"sql": "SELECT ARRAY_COMPACT(ARRAY_CONSTRUCT(ARRAY_CONSTRUCT(1, NULL)))", "expect": {"value": "[[1,undefined]]"}}
    ]},
    {"name": "flatten-skips-undefined-but-keeps-a-json-null", "steps": [
      {"sql": "SELECT COUNT(*) FROM TABLE(FLATTEN(ARRAY_CONSTRUCT(1, NULL, 2)))", "expect": {"value": "2"}},
      {"sql": "SELECT COUNT(*) FROM TABLE(FLATTEN(PARSE_JSON('[1,null,2]')))", "expect": {"value": "3"}},
      {"sql": "SELECT LISTAGG(TYPEOF(value), ',') FROM TABLE(FLATTEN(ARRAY_CONSTRUCT(1, NULL, 2)))", "expect": {"value": "INTEGER,INTEGER"}},
      {"sql": "SELECT LISTAGG(TYPEOF(value), ',') FROM TABLE(FLATTEN(PARSE_JSON('[1,null,2]')))", "expect": {"value": "INTEGER,NULL_VALUE,INTEGER"}},
      {"sql": "SELECT LISTAGG(index::string, ',') FROM TABLE(FLATTEN(ARRAY_CONSTRUCT(1, NULL, 2)))", "expect": {"value": "0,2"}},
      {"sql": "SELECT LISTAGG(index::string, ',') FROM TABLE(FLATTEN(PARSE_JSON('[1,null,2]')))", "expect": {"value": "0,1,2"}}
    ]},
    {"name": "flatten-over-an-all-undefined-array-behaves-like-an-empty-one", "steps": [
      {"sql": "SELECT COUNT(*) FROM TABLE(FLATTEN(ARRAY_CONSTRUCT(NULL)))", "expect": {"value": "0"}},
      {"sql": "SELECT COUNT(*) FROM TABLE(FLATTEN(input => ARRAY_CONSTRUCT(NULL), outer => TRUE))", "expect": {"value": "1"}},
      {"sql": "SELECT COUNT(*) FROM TABLE(FLATTEN(input => ARRAY_CONSTRUCT(ARRAY_CONSTRUCT(1, NULL), 2), recursive => TRUE))", "expect": {"value": "3"}},
      {"sql": "SELECT COUNT(*) FROM TABLE(FLATTEN(input => PARSE_JSON('[[1,null],2]'), recursive => TRUE))", "expect": {"value": "4"}}
    ]},
    {"name": "array-to-string-renders-undefined-as-empty", "steps": [
      {"sql": "SELECT ARRAY_TO_STRING(ARRAY_CONSTRUCT(1, NULL, 2), '|')", "expect": {"value": "1||2"}},
      {"sql": "SELECT ARRAY_TO_STRING(ARRAY_CONSTRUCT('a', NULL), ',')", "expect": {"value": "a,"}},
      {"sql": "SELECT '<' || ARRAY_TO_STRING(ARRAY_CONSTRUCT(NULL), '|') || '>'", "expect": {"value": "<>"}}
    ]},
    {"name": "array-contains-and-position-match-only-their-own-null", "steps": [
      {"sql": "SELECT ARRAY_CONTAINS(NULL::VARIANT, ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "true"}},
      {"sql": "SELECT ARRAY_CONTAINS(NULL::VARIANT, PARSE_JSON('[1,null,2]'))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_CONTAINS(NULL::VARIANT, ARRAY_CONSTRUCT(1, 2))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_CONTAINS(PARSE_JSON('null'), ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "false"}},
      {"sql": "SELECT ARRAY_CONTAINS(PARSE_JSON('null'), PARSE_JSON('[1,null,2]'))", "expect": {"value": "true"}},
      {"sql": "SELECT ARRAY_POSITION(NULL::VARIANT, ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "1"}},
      {"sql": "SELECT ARRAY_POSITION(NULL::VARIANT, PARSE_JSON('[1,null,2]'))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_POSITION(NULL::VARIANT, ARRAY_CONSTRUCT(1, 2))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_POSITION(PARSE_JSON('null'), ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_POSITION(PARSE_JSON('null'), PARSE_JSON('[1,null,2]'))", "expect": {"value": "1"}}
    ]},
    {"name": "array-remove-with-a-sql-null-value-propagates", "steps": [
      {"sql": "SELECT ARRAY_REMOVE(ARRAY_CONSTRUCT(1, NULL, 2), NULL)", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_REMOVE(ARRAY_CONSTRUCT(1, NULL, 2), PARSE_JSON('null'))", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT ARRAY_REMOVE(PARSE_JSON('[1,null,2]'), PARSE_JSON('null'))", "expect": {"value": "[1,2]"}},
      {"sql": "SELECT ARRAY_REMOVE_AT(ARRAY_CONSTRUCT(1, NULL, 2), 1)", "expect": {"value": "[1,2]"}}
    ]},
    {"name": "array-min-and-max-ignore-undefined-but-rank-a-json-null-highest", "steps": [
      {"sql": "SELECT ARRAY_MIN(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "1"}},
      {"sql": "SELECT ARRAY_MAX(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "2"}},
      {"sql": "SELECT ARRAY_MIN(PARSE_JSON('[1,null,2]'))", "expect": {"value": "1"}},
      {"sql": "SELECT TYPEOF(ARRAY_MAX(PARSE_JSON('[1,null,2]')))", "expect": {"value": "NULL_VALUE"}},
      {"sql": "SELECT ARRAY_MAX(PARSE_JSON('[1,null,2]')) IS NULL", "expect": {"value": "false"}},
      {"sql": "SELECT TO_JSON(ARRAY_MAX(PARSE_JSON('[1,null,2]')))", "expect": {"value": "null"}},
      {"sql": "SELECT ARRAY_MIN(ARRAY_CONSTRUCT(NULL))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT ARRAY_MAX(ARRAY_CONSTRUCT(NULL))", "expect": {"rows": [[null]]}}
    ]},
    {"name": "positional-array-functions-carry-the-element-through", "steps": [
      {"sql": "SELECT ARRAY_SLICE(ARRAY_CONSTRUCT(1, NULL, 2), 0, 2)", "expect": {"value": "[1,undefined]"}},
      {"sql": "SELECT ARRAY_SLICE(ARRAY_CONSTRUCT(1, NULL, 2), 1, 3)", "expect": {"value": "[undefined,2]"}},
      {"sql": "SELECT ARRAY_SLICE(PARSE_JSON('[1,null,2]'), 1, 3)", "expect": {"value": "[null,2]"}},
      {"sql": "SELECT ARRAY_CAT(ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(9))", "expect": {"value": "[1,undefined,2,9]"}},
      {"sql": "SELECT ARRAY_CAT(PARSE_JSON('[1,null,2]'), ARRAY_CONSTRUCT(NULL))", "expect": {"value": "[1,null,2,undefined]"}},
      {"sql": "SELECT ARRAY_REVERSE(ARRAY_CONSTRUCT(1, NULL, 2))", "expect": {"value": "[2,undefined,1]"}},
      {"sql": "SELECT ARRAY_FLATTEN(ARRAY_CONSTRUCT(ARRAY_CONSTRUCT(1, NULL), ARRAY_CONSTRUCT(2)))", "expect": {"value": "[1,undefined,2]"}}
    ]},
    {"name": "array-distinct-moves-the-undefined-last-only-when-it-deduplicates", "steps": [
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(NULL, 1, 2))", "expect": {"value": "[undefined,1,2]"}},
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(2, NULL, 1))", "expect": {"value": "[2,undefined,1]"}},
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(NULL, 1, 1))", "expect": {"value": "[1,undefined]"}},
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(NULL, NULL, 1))", "expect": {"value": "[1,undefined]"}},
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(NULL, 2, NULL, 1))", "expect": {"value": "[2,1,undefined]"}},
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(1, NULL, 1, NULL, 2))", "expect": {"value": "[1,2,undefined]"}},
      {"sql": "SELECT ARRAY_DISTINCT(PARSE_JSON('[1,null,1,null,2]'))", "expect": {"value": "[1,null,2]"}},
      {"sql": "SELECT ARRAY_DISTINCT(ARRAY_CONSTRUCT(NULL, PARSE_JSON('null'), NULL, PARSE_JSON('null'), 1))", "expect": {"value": "[null,1,undefined]"}}
    ]},
    {"name": "set-functions-treat-the-two-nulls-as-different-elements", "steps": [
      {"sql": "SELECT ARRAYS_OVERLAP(ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(NULL))", "expect": {"value": "true"}},
      {"sql": "SELECT ARRAYS_OVERLAP(ARRAY_CONSTRUCT(1, NULL, 2), PARSE_JSON('[null]'))", "expect": {"value": "false"}},
      {"sql": "SELECT ARRAYS_OVERLAP(PARSE_JSON('[1,null,2]'), PARSE_JSON('[null]'))", "expect": {"value": "true"}},
      {"sql": "SELECT ARRAY_EXCEPT(ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(1))", "expect": {"value": "[undefined,2]"}},
      {"sql": "SELECT ARRAY_EXCEPT(ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(NULL))", "expect": {"value": "[1,2]"}},
      {"sql": "SELECT ARRAY_EXCEPT(PARSE_JSON('[1,null,2]'), ARRAY_CONSTRUCT(NULL))", "expect": {"value": "[1,null,2]"}},
      {"sql": "SELECT ARRAY_INTERSECTION(ARRAY_CONSTRUCT(1, NULL, 2), ARRAY_CONSTRUCT(NULL))", "expect": {"value": "[undefined]"}},
      {"sql": "SELECT ARRAY_INTERSECTION(PARSE_JSON('[1,null,2]'), ARRAY_CONSTRUCT(NULL))", "expect": {"value": "[]"}},
      {"sql": "SELECT ARRAY_INTERSECTION(ARRAY_CONSTRUCT(1, NULL, 2), PARSE_JSON('[1,null,2]'))", "expect": {"value": "[1,2]"}}
    ]},
    {"name": "set-functions-are-multiset-operations", "steps": [
      {"sql": "SELECT ARRAY_EXCEPT(ARRAY_CONSTRUCT(1, 1, 2), ARRAY_CONSTRUCT())", "expect": {"value": "[1,1,2]"}},
      {"sql": "SELECT ARRAY_EXCEPT(ARRAY_CONSTRUCT(NULL, 1, NULL), ARRAY_CONSTRUCT(1))", "expect": {"value": "[undefined,undefined]"}},
      {"sql": "SELECT ARRAY_INTERSECTION(ARRAY_CONSTRUCT(NULL, 1, NULL), ARRAY_CONSTRUCT(NULL, 1))", "expect": {"value": "[1,undefined]"}}
    ]},
    {"name": "object-builders-downgrade-an-undefined-to-a-json-null", "steps": [
      {"sql": "SELECT ARRAYS_ZIP(ARRAY_CONSTRUCT(1, NULL), ARRAY_CONSTRUCT(2, 3))", "expect": {"value": "[{\"$1\":1,\"$2\":2},{\"$1\":null,\"$2\":3}]"}},
      {"sql": "SELECT ARRAYS_TO_OBJECT(ARRAY_CONSTRUCT('a', 'b'), ARRAY_CONSTRUCT(1, NULL))", "expect": {"value": "{\"a\":1,\"b\":null}"}}
    ]},
    {"name": "array-construct-compact-and-filter-still-work",
     "steps": [
      {"sql": "SELECT ARRAY_CONSTRUCT_COMPACT(1, NULL, 2)", "expect": {"value": "[1,2]"}},
      {"sql": "SELECT FILTER(ARRAY_CONSTRUCT(1, NULL, 2), x -> TRUE)", "expect": {"value": "[1,undefined,2]"}}
    ]},
    {"name": "the-sentinel-never-leaks-into-scalar-evaluation", "steps": [
      {"sql": "SELECT NVL(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1), 9)", "expect": {"value": "9"}},
      {"sql": "SELECT GET(ARRAY_CONSTRUCT(1, NULL, 2), 1)::VARCHAR", "expect": {"rows": [[null]]}},
      {"sql": "SELECT TO_ARRAY(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT GET(ARRAY_CONSTRUCT(1, NULL, 2), 1) + 1", "expect": {"rows": [[null]]}},
      {"sql": "SELECT UPPER(GET(ARRAY_CONSTRUCT(1, NULL, 2), 1))", "expect": {"rows": [[null]]}},
      {"sql": "SELECT REDUCE(ARRAY_CONSTRUCT(1, NULL, 2), 0, (acc, x) -> acc + COALESCE(x::int, 10))", "expect": {"value": "13"}}
    ]},
    {"name": "the-token-survives-every-text-round-trip", "steps": [
      {"sql": "SELECT PARSE_JSON(TO_JSON(ARRAY_CONSTRUCT(1, NULL, 2)))", "expect": {"value": "[1,undefined,2]"}},
      {"sql": "SELECT PARSE_JSON(TO_JSON(ARRAY_CONSTRUCT(1, NULL, 2))) = ARRAY_CONSTRUCT(1, NULL, 2)", "expect": {"value": "true"}},
      {"sql": "SELECT IFF(ARRAY_CONSTRUCT(1, NULL, 2) IS NULL, 'null', 'set')", "expect": {"value": "set"}},
      {"sql": "SELECT STARTSWITH(TO_JSON(ARRAY_SLICE(PARSE_JSON('[1,undefined,2]'), 1, 3)), '[undefined')", "expect": {"value": "true"}}
    ]}
  ]
}
