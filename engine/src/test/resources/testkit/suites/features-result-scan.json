{
  "suite": "features-result-scan",
  "description": "RESULT_SCAN and LAST_QUERY_ID(): the id is a UUID, RESULT_SCAN(LAST_QUERY_ID()) replays the previous statement's rows, a captured id replays the same result later, successive scans follow successive queries, and a scan can be filtered, joined, aggregated and re-ordered like any relation. The no-argument form scans the most recent query, an unknown id and a malformed id each carry their own wording, LAST_QUERY_ID honours its offset argument, and an offset that resolves to nothing reports no previous query results. Converted 1:1 from features/ResultScanTest (now retired). The empty-history test runs first so the offset resolves to nothing, and skips snowflake as the Java class did.",
  "tags": ["features", "converted"],
  "tests": [
    {"name": "result-scan-over-an-empty-history-reports-no-previous-results",
     "skip": {"backends": ["snowflake"], "reason": "an empty query history cannot be arranged on the shared live session"},
     "steps": [
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN(LAST_QUERY_ID(-99)))",
       "expect": {"error": {"messageContains": "No previous query results available"}}}
    ]},
    {"name": "last-query-id", "steps": [
      {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR)"},
      {"sql": "INSERT INTO users VALUES (1, 'Alice'), (2, 'Bob')"},
      {"sql": "SELECT * FROM users", "expect": {"rowCount": 2}},
      {"sql": "SELECT LAST_QUERY_ID() RLIKE '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}'",
       "expect": {"value": "true"}}
    ]},
    {"name": "result-scan-with-last-query-id", "steps": [
      {"sql": "CREATE TABLE products (id INTEGER, name VARCHAR, price FLOAT)"},
      {"sql": "INSERT INTO products VALUES (1, 'Widget', 19.99), (2, 'Gadget', 29.99), (3, 'Tool', 39.99)"},
      {"sql": "SELECT * FROM products WHERE price > 20", "expect": {"rowCount": 2}},
      {"sql": "SELECT id, name FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) ORDER BY id",
       "expect": {"rowCount": 2, "rows": [["2", "Gadget"], ["3", "Tool"]], "ordered": true}}
    ]},
    {"name": "result-scan-with-specific-query-id", "steps": [
      {"sql": "CREATE TABLE orders (id INTEGER, amount FLOAT)"},
      {"sql": "INSERT INTO orders VALUES (1, 100.0), (2, 200.0), (3, 300.0)"},
      {"sql": "SELECT * FROM orders WHERE amount > 150"},
      {"sql": "SET qid = LAST_QUERY_ID()"},
      {"sql": "SELECT id FROM TABLE(RESULT_SCAN($qid)) ORDER BY id",
       "expect": {"rowCount": 2, "rows": [["2"], ["3"]], "ordered": true}}
    ]},
    {"name": "result-scan-multiple-queries", "steps": [
      {"sql": "CREATE TABLE items (id INTEGER, category VARCHAR)"},
      {"sql": "INSERT INTO items VALUES (1, 'A'), (2, 'B')"},
      {"sql": "SELECT * FROM items WHERE category = 'A'", "expect": {"rowCount": 1}},
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rowCount": 1}},
      {"sql": "INSERT INTO items VALUES (3, 'A'), (4, 'C')"},
      {"sql": "SELECT * FROM items WHERE category = 'A'", "expect": {"rowCount": 2}},
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rowCount": 2}}
    ]},
    {"name": "result-scan-with-filtering", "steps": [
      {"sql": "CREATE TABLE numbers (id INTEGER, value INTEGER)"},
      {"sql": "INSERT INTO numbers VALUES (1, 10), (2, 20), (3, 30), (4, 40)"},
      {"sql": "SELECT * FROM numbers WHERE value > 15"},
      {"sql": "SELECT value FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE value >= 30 ORDER BY value",
       "expect": {"rowCount": 2, "rows": [["30"], ["40"]], "ordered": true}}
    ]},
    {"name": "result-scan-with-join", "steps": [
      {"sql": "CREATE TABLE customers (id INTEGER, name VARCHAR)"},
      {"sql": "INSERT INTO customers VALUES (1, 'Alice'), (2, 'Bob')"},
      {"sql": "SELECT * FROM customers"},
      {"sql": "SELECT r.name FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) r, TABLE(GENERATOR(ROWCOUNT => 2)) g",
       "expect": {"rowCount": 4}}
    ]},
    {"name": "result-scan-with-aggregation", "steps": [
      {"sql": "CREATE TABLE sales (product VARCHAR, amount FLOAT)"},
      {"sql": "INSERT INTO sales VALUES ('A', 100), ('B', 200), ('A', 150), ('B', 250)"},
      {"sql": "SELECT * FROM sales WHERE amount > 100"},
      {"sql": "SELECT COUNT(*) AS total FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"value": "3"}}
    ]},
    {"name": "result-scan-invalid-query-id", "steps": [
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN('00000000-0000-0000-0000-000000000000'))",
       "expect": {"error": {"messageContains": "not found"}}}
    ]},
    {"name": "result-scan-invalid-format", "steps": [
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN('invalid-query-id'))",
       "expect": {"error": {"messageContains": "invalid"}}}
    ]},
    {"name": "result-scan-no-arguments", "steps": [
      {"sql": "SELECT 41 AS n"},
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN())", "expect": {"rowCount": 1, "value": "41"}}
    ]},
    {"name": "last-query-id-after-ddl", "steps": [
      {"sql": "CREATE TABLE test_table (id INTEGER)"},
      {"sql": "INSERT INTO test_table VALUES (1)"},
      {"sql": "SELECT * FROM test_table", "expect": {"rowCount": 1}},
      {"sql": "SET qid = LAST_QUERY_ID()"},
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN($qid))", "expect": {"rowCount": 1}}
    ]},
    {"name": "result-scan-with-order-by", "steps": [
      {"sql": "CREATE TABLE data (id INTEGER, value VARCHAR)"},
      {"sql": "INSERT INTO data VALUES (3, 'C'), (1, 'A'), (2, 'B')"},
      {"sql": "SELECT * FROM data ORDER BY id"},
      {"sql": "SELECT id FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) ORDER BY id DESC",
       "expect": {"rows": [["3"], ["2"], ["1"]], "ordered": true}}
    ]},
    {"name": "result-scan-cache-size-limit", "steps": [
      {"sql": "CREATE TABLE test (id INTEGER)"},
      {"sql": "INSERT INTO test VALUES (1)"},
      {"sql": "SELECT * FROM test"},
      {"sql": "SET first_qid = LAST_QUERY_ID()"},
      {"sql": "SELECT * FROM test WHERE id = 0"},
      {"sql": "SELECT * FROM test WHERE id = 1"},
      {"sql": "SELECT * FROM test WHERE id = 2"},
      {"sql": "SELECT * FROM test WHERE id = 3"},
      {"sql": "SELECT * FROM test WHERE id = 4"},
      {"sql": "SELECT * FROM test WHERE id = 5"},
      {"sql": "SELECT * FROM test WHERE id = 6"},
      {"sql": "SELECT * FROM test WHERE id = 7"},
      {"sql": "SELECT * FROM test WHERE id = 8"},
      {"sql": "SELECT * FROM test WHERE id = 9"},
      {"sql": "SELECT * FROM TABLE(RESULT_SCAN($first_qid))", "expect": {"rowCount": 1}}
    ]},
    {"name": "result-scan-honours-the-last-query-id-offset", "steps": [
      {"sql": "CREATE DATABASE offset_db"},
      {"sql": "USE DATABASE offset_db"},
      {"sql": "USE SCHEMA public"},
      {"sql": "CREATE TABLE three (k INTEGER)"},
      {"sql": "INSERT INTO three VALUES (1), (2), (3)"},
      {"sql": "SELECT * FROM three"},
      {"sql": "SELECT 1"},
      {"sql": "SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID(-1)))", "expect": {"value": "1"}},
      {"sql": "SELECT * FROM three"},
      {"sql": "SELECT 1"},
      {"sql": "SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID(-2)))", "expect": {"value": "3"}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "USE SCHEMA test_schema"},
      {"sql": "DROP DATABASE IF EXISTS offset_db"}
    ]}
  ]
}
