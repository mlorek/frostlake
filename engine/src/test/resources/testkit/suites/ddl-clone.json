{
  "suite": "ddl-clone",
  "description": "CLONE of databases, schemas and tables: structure and data copied, clones independent of their source in both directions, IF NOT EXISTS, qualified names, PK/comment survival, does-not-exist and already-exists refusals, cloned UDFs/procedures keeping their non-SQL LANGUAGE, and cloned databases keeping stage and file-format definitions. Converted 1:1 from ddl/CloneTest (now retired). Databases created by tests are dropped at the end; the stage test uses an s3:// URL because the engine's file:// stage convenience is config-gated off in the default engine (Probe16) - the assertion (CLONE keeps the stage definition) is unchanged.",
  "tags": ["ddl", "converted"],
  "tests": [
    {"name": "clone-database", "steps": [
      {"sql": "CREATE DATABASE source_db"},
      {"sql": "USE DATABASE source_db"},
      {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR)"},
      {"sql": "INSERT INTO users VALUES (1, 'Alice'), (2, 'Bob')"},
      {"sql": "CREATE VIEW user_view AS SELECT * FROM users"},
      {"sql": "CREATE DATABASE cloned_db CLONE source_db"},
      {"sql": "SHOW DATABASES LIKE 'cloned_db'", "expect": {"rowCount": 1}},
      {"sql": "USE DATABASE cloned_db"},
      {"sql": "SHOW TABLES LIKE 'users'", "expect": {"rowCount": 1}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS source_db"},
      {"sql": "DROP DATABASE IF EXISTS cloned_db"}
    ]},
    {"name": "clone-schema", "steps": [
      {"sql": "CREATE SCHEMA source_schema"},
      {"sql": "USE SCHEMA source_schema"},
      {"sql": "CREATE TABLE products (id INTEGER, name VARCHAR, price FLOAT)"},
      {"sql": "INSERT INTO products VALUES (1, 'Widget', 19.99), (2, 'Gadget', 29.99)"},
      {"sql": "CREATE SCHEMA cloned_schema CLONE source_schema"},
      {"sql": "SHOW SCHEMAS LIKE 'cloned_schema'", "expect": {"rowCount": 1}},
      {"sql": "USE SCHEMA cloned_schema"},
      {"sql": "SHOW TABLES LIKE 'products'", "expect": {"rowCount": 1}}
    ]},
    {"name": "clone-table-structure-and-data", "steps": [
      {"sql": "CREATE TABLE source_table (id INTEGER, value VARCHAR, amount FLOAT)"},
      {"sql": "INSERT INTO source_table VALUES (1, 'A', 100.0), (2, 'B', 200.0), (3, 'C', 300.0)"},
      {"sql": "CREATE TABLE cloned_table CLONE source_table"},
      {"sql": "SHOW TABLES LIKE 'cloned_table'", "expect": {"rowCount": 1}},
      {"sql": "SHOW COLUMNS IN TABLE cloned_table", "expect": {"rowCount": 3}},
      {"sql": "SELECT * FROM cloned_table ORDER BY id",
       "expect": {"rows": [["1", "A", "100"], ["2", "B", "200"], ["3", "C", "300"]], "ordered": true}}
    ]},
    {"name": "clone-table-independence", "steps": [
      {"sql": "CREATE TABLE original (id INTEGER, name VARCHAR)"},
      {"sql": "INSERT INTO original VALUES (1, 'Original')"},
      {"sql": "CREATE TABLE copy CLONE original"},
      {"sql": "INSERT INTO original VALUES (2, 'NewRow')"},
      {"sql": "SELECT * FROM original", "expect": {"rowCount": 2}},
      {"sql": "SELECT * FROM copy", "expect": {"rowCount": 1}}
    ]},
    {"name": "clone-table-with-primary-key", "steps": [
      {"sql": "CREATE TABLE source_pk (id INTEGER PRIMARY KEY, data VARCHAR)"},
      {"sql": "INSERT INTO source_pk VALUES (1, 'Data1'), (2, 'Data2')"},
      {"sql": "CREATE TABLE cloned_pk CLONE source_pk"},
      {"sql": "SHOW COLUMNS IN TABLE cloned_pk"},
      {"sql": "SELECT COUNT(*) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"column_name\" = 'ID'", "expect": {"value": "1"}},
      {"sql": "SELECT * FROM cloned_pk ORDER BY id", "expect": {"rowCount": 2}}
    ]},
    {"name": "clone-table-qualified-names", "steps": [
      {"sql": "CREATE SCHEMA schema1"},
      {"sql": "CREATE TABLE schema1.source_table (id INTEGER, value VARCHAR)"},
      {"sql": "INSERT INTO schema1.source_table VALUES (1, 'Test')"},
      {"sql": "CREATE SCHEMA schema2"},
      {"sql": "CREATE TABLE schema2.cloned_table CLONE schema1.source_table"},
      {"sql": "SELECT * FROM schema2.cloned_table", "expect": {"rows": [["1", "Test"]]}}
    ]},
    {"name": "clone-schema-qualified-names", "steps": [
      {"sql": "CREATE DATABASE db1"},
      {"sql": "USE DATABASE db1"},
      {"sql": "CREATE SCHEMA source_schema"},
      {"sql": "CREATE TABLE source_schema.test_table (id INTEGER)"},
      {"sql": "CREATE SCHEMA cloned_schema CLONE source_schema"},
      {"sql": "SHOW SCHEMAS LIKE 'cloned_schema'", "expect": {"rowCount": 1}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS db1"}
    ]},
    {"name": "clone-database-if-not-exists", "steps": [
      {"sql": "CREATE DATABASE source_db"},
      {"sql": "CREATE DATABASE cloned_db CLONE source_db"},
      {"sql": "CREATE DATABASE IF NOT EXISTS cloned_db CLONE source_db"},
      {"sql": "SHOW DATABASES LIKE 'cloned_db'", "expect": {"rowCount": 1}},
      {"sql": "DROP DATABASE IF EXISTS source_db"},
      {"sql": "DROP DATABASE IF EXISTS cloned_db"}
    ]},
    {"name": "clone-empty-table", "steps": [
      {"sql": "CREATE TABLE empty_table (id INTEGER, name VARCHAR)"},
      {"sql": "CREATE TABLE cloned_empty CLONE empty_table"},
      {"sql": "SELECT * FROM cloned_empty", "expect": {"rowCount": 0}}
    ]},
    {"name": "clone-table-with-comment", "steps": [
      {"sql": "CREATE TABLE source_table (id INTEGER) COMMENT = 'Source table comment'"},
      {"sql": "INSERT INTO source_table VALUES (1)"},
      {"sql": "CREATE TABLE cloned_table CLONE source_table"},
      {"sql": "SELECT * FROM cloned_table", "expect": {"rowCount": 1}}
    ]},
    {"name": "clone-non-existent-database", "steps": [
      {"sql": "CREATE DATABASE cloned_db CLONE non_existent_db",
       "expect": {"error": {"messageContains": "does not exist"}}}
    ]},
    {"name": "clone-non-existent-table", "steps": [
      {"sql": "CREATE TABLE cloned_table CLONE non_existent_table",
       "expect": {"error": {"messageContains": "does not exist"}}}
    ]},
    {"name": "clone-duplicate-name", "steps": [
      {"sql": "CREATE DATABASE source_db"},
      {"sql": "CREATE DATABASE target_db"},
      {"sql": "CREATE DATABASE target_db CLONE source_db",
       "expect": {"error": {"messageContains": "already exists"}}},
      {"sql": "DROP DATABASE IF EXISTS source_db"},
      {"sql": "DROP DATABASE IF EXISTS target_db"}
    ]},
    {"name": "clone-database-copies-data", "steps": [
      {"sql": "CREATE DATABASE source_db"},
      {"sql": "USE DATABASE source_db"},
      {"sql": "CREATE TABLE users (id INTEGER, name VARCHAR)"},
      {"sql": "INSERT INTO users VALUES (1, 'Alice'), (2, 'Bob')"},
      {"sql": "CREATE DATABASE cloned_db CLONE source_db"},
      {"sql": "USE DATABASE cloned_db"},
      {"sql": "USE SCHEMA public"},
      {"sql": "SELECT * FROM users ORDER BY id", "expect": {"rows": [["1", "Alice"], ["2", "Bob"]], "ordered": true}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS source_db"},
      {"sql": "DROP DATABASE IF EXISTS cloned_db"}
    ]},
    {"name": "clone-database-data-independence", "steps": [
      {"sql": "CREATE DATABASE source_db"},
      {"sql": "USE DATABASE source_db"},
      {"sql": "CREATE TABLE items (id INTEGER, val VARCHAR)"},
      {"sql": "INSERT INTO items VALUES (1, 'original')"},
      {"sql": "CREATE DATABASE cloned_db CLONE source_db"},
      {"sql": "USE DATABASE source_db"},
      {"sql": "USE SCHEMA public"},
      {"sql": "INSERT INTO items VALUES (2, 'added-to-source')"},
      {"sql": "USE DATABASE cloned_db"},
      {"sql": "USE SCHEMA public"},
      {"sql": "SELECT COUNT(*) FROM items", "expect": {"value": "1"}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS source_db"},
      {"sql": "DROP DATABASE IF EXISTS cloned_db"}
    ]},
    {"name": "clone-schema-copies-data", "steps": [
      {"sql": "CREATE SCHEMA src"},
      {"sql": "USE SCHEMA src"},
      {"sql": "CREATE TABLE orders (id INTEGER, amount FLOAT)"},
      {"sql": "INSERT INTO orders VALUES (1, 99.9), (2, 49.5), (3, 199.0)"},
      {"sql": "CREATE SCHEMA dst CLONE src"},
      {"sql": "USE SCHEMA dst"},
      {"sql": "SELECT COUNT(*) FROM orders", "expect": {"value": "3"}}
    ]},
    {"name": "clone-schema-data-independence", "steps": [
      {"sql": "CREATE SCHEMA src"},
      {"sql": "USE SCHEMA src"},
      {"sql": "CREATE TABLE kv (k VARCHAR, v INTEGER)"},
      {"sql": "INSERT INTO kv VALUES ('a', 1)"},
      {"sql": "CREATE SCHEMA dst CLONE src"},
      {"sql": "USE SCHEMA src"},
      {"sql": "DELETE FROM kv WHERE k = 'a'"},
      {"sql": "USE SCHEMA dst"},
      {"sql": "SELECT COUNT(*) FROM kv", "expect": {"value": "1"}}
    ]},
    {"name": "clone-database-multiple-tables-and-schemas", "steps": [
      {"sql": "CREATE DATABASE src_db"},
      {"sql": "USE DATABASE src_db"},
      {"sql": "CREATE TABLE t1 (id INTEGER)"},
      {"sql": "INSERT INTO t1 VALUES (10), (20)"},
      {"sql": "CREATE SCHEMA extra"},
      {"sql": "USE SCHEMA extra"},
      {"sql": "CREATE TABLE t2 (name VARCHAR)"},
      {"sql": "INSERT INTO t2 VALUES ('x'), ('y'), ('z')"},
      {"sql": "CREATE DATABASE tgt_db CLONE src_db"},
      {"sql": "USE DATABASE tgt_db"},
      {"sql": "USE SCHEMA public"},
      {"sql": "SELECT COUNT(*) FROM t1", "expect": {"value": "2"}},
      {"sql": "USE SCHEMA extra"},
      {"sql": "SELECT COUNT(*) FROM t2", "expect": {"value": "3"}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS src_db"},
      {"sql": "DROP DATABASE IF EXISTS tgt_db"}
    ]},
    {"name": "clone-keeps-non-sql-function-language", "steps": [
      {"sql": "CREATE DATABASE fn_src"},
      {"sql": "USE DATABASE fn_src"},
      {"sql": "CREATE SCHEMA utils"},
      {"sql": "CREATE OR REPLACE FUNCTION fn_src.utils.java_id() RETURNS VARCHAR LANGUAGE JAVA HANDLER='Tools.id' AS 'class Tools{ public static String id(){ return \"java-ok\"; } }'"},
      {"sql": "CREATE OR REPLACE FUNCTION fn_src.utils.sql_id() RETURNS VARCHAR AS 'UPPER(''sql-ok'')'"},
      {"sql": "CREATE DATABASE fn_tgt CLONE fn_src"},
      {"sql": "SELECT fn_tgt.utils.java_id()", "expect": {"value": "java-ok"}},
      {"sql": "SELECT fn_tgt.utils.sql_id()", "expect": {"value": "SQL-OK"}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS fn_src"},
      {"sql": "DROP DATABASE IF EXISTS fn_tgt"}
    ]},
    {"name": "clone-keeps-non-sql-procedure-language",
     "skip": {"backends": ["snowflake"], "reason": "an inline Java handler needs PACKAGES = ('com.snowflake:snowpark:latest') on the account (Java test had the same assumption)"},
     "steps": [
      {"sql": "CREATE DATABASE pr_src"},
      {"sql": "USE DATABASE pr_src"},
      {"sql": "CREATE SCHEMA utils"},
      {"sql": "CREATE OR REPLACE PROCEDURE pr_src.utils.java_proc()\nRETURNS VARCHAR\nLANGUAGE JAVA\nHANDLER='CloneProc.run'\nAS\n$$\npublic class CloneProc {\n  public String run(com.snowflake.snowpark_java.Session session) {\n    return \"java-ok\";\n  }\n}\n$$"},
      {"sql": "CREATE DATABASE pr_tgt CLONE pr_src"},
      {"sql": "CALL pr_tgt.utils.java_proc()", "expect": {"value": "java-ok"}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS pr_src"},
      {"sql": "DROP DATABASE IF EXISTS pr_tgt"}
    ]},
    {"name": "clone-database-keeps-stages-and-file-formats", "steps": [
      {"sql": "CREATE DATABASE st_src"},
      {"sql": "USE DATABASE st_src"},
      {"sql": "CREATE SCHEMA depot"},
      {"sql": "CREATE STAGE depot.jar_stage URL='s3://frostlake-clone-test/jars'"},
      {"sql": "CREATE FILE FORMAT depot.csv_fmt TYPE = 'CSV'"},
      {"sql": "CREATE DATABASE st_tgt CLONE st_src"},
      {"sql": "USE DATABASE st_tgt"},
      {"sql": "USE SCHEMA depot"},
      {"sql": "SHOW STAGES LIKE 'jar_stage'", "expect": {"rowCount": 1}},
      {"sql": "SELECT \"url\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'JAR_STAGE'",
       "expect": {"value": "s3://frostlake-clone-test/jars"}},
      {"sql": "SHOW FILE FORMATS LIKE 'csv_fmt'", "expect": {"rowCount": 1}},
      {"sql": "SELECT \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'CSV_FMT'",
       "expect": {"value": "CSV"}},
      {"sql": "USE DATABASE test_db"},
      {"sql": "DROP DATABASE IF EXISTS st_src"},
      {"sql": "DROP DATABASE IF EXISTS st_tgt"}
    ]}
  ]
}
