{
  "suite": "ddl-show-timestamp-types",
  "description": "Every SHOW command's timestamp column is declared TIMESTAMP_LTZ and carries a temporal value, while the three lookalikes (retention_time, granted_on, mins_to_unlock/days_to_expiry) stay VARCHAR - measured across the whole family on a real account. Declared types are read through a CTAS-over-RESULT_SCAN + DESCRIBE proxy (the CTAS inherits the listing's column types). Converted 1:1 from ddl/ShowTimestampTypeTest (now retired).",
  "tags": ["ddl", "converted"],
  "tests": [
    {"name": "every-show-command-declares-its-timestamp-columns-timestamp-ltz",
     "skip": {"backends": ["snowflake"], "reason": "CREATE WAREHOUSE makes the new warehouse the session's current one on a real account, and the test drops it, which would leave the rest of a live run with no warehouse"},
     "steps": [
      {"sql": "CREATE TABLE t (a INT)"},
      {"sql": "CREATE VIEW v AS SELECT a FROM t"},
      {"sql": "CREATE SEQUENCE sq"},
      {"sql": "CREATE STAGE stg"},
      {"sql": "CREATE FILE FORMAT ff TYPE = CSV"},
      {"sql": "CREATE STREAM strm ON TABLE t"},
      {"sql": "CREATE WAREHOUSE wh"},
      {"sql": "CREATE TASK tk WAREHOUSE = wh SCHEDULE = '60 MINUTE' AS SELECT 1"},
      {"sql": "CREATE OR REPLACE ROLE r"},
      {"sql": "CREATE OR REPLACE USER u"},
      {"sql": "SHOW TABLES"},
      {"sql": "CREATE TABLE p01 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p01"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW VIEWS"},
      {"sql": "CREATE TABLE p02 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p02"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW OBJECTS"},
      {"sql": "CREATE TABLE p03 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p03"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW SEQUENCES"},
      {"sql": "CREATE TABLE p04 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p04"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW STAGES"},
      {"sql": "CREATE TABLE p05 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p05"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW FILE FORMATS"},
      {"sql": "CREATE TABLE p06 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p06"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW STREAMS"},
      {"sql": "CREATE TABLE p07 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p07"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW TASKS"},
      {"sql": "CREATE TABLE p08 AS SELECT \"created_on\", \"last_committed_on\", \"last_suspended_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
