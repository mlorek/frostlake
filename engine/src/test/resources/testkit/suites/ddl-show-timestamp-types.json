      {"sql": "CREATE TABLE p14 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p14"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW PROCEDURES"},
      {"sql": "CREATE TABLE p15 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p15"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW TAGS"},
      {"sql": "CREATE TABLE p16 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p16"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW MASKING POLICIES"},
      {"sql": "CREATE TABLE p17 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p17"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "SHOW ROW ACCESS POLICIES"},
      {"sql": "CREATE TABLE p18 AS SELECT \"created_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE p18"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["created_on", "TIMESTAMP_LTZ(3)"]]}},
      {"sql": "DROP TASK tk"},
      {"sql": "DROP WAREHOUSE wh"},
      {"sql": "DROP ROLE r"},
      {"sql": "DROP USER u"}
    ]},
    {"name": "the-columns-that-only-look-temporal-stay-text", "steps": [
      {"sql": "CREATE TABLE t (a INT)"},
      {"sql": "CREATE OR REPLACE ROLE r"},
      {"sql": "CREATE OR REPLACE USER u"},
      {"sql": "SHOW TABLES"},
      {"sql": "CREATE TABLE q1 AS SELECT \"retention_time\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE q1"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["retention_time", "VARCHAR(16777216)"]]}},
      {"sql": "SHOW DATABASES"},
      {"sql": "CREATE TABLE q2 AS SELECT \"retention_time\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE q2"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["retention_time", "VARCHAR(16777216)"]]}},
      {"sql": "SHOW SCHEMAS"},
      {"sql": "CREATE TABLE q3 AS SELECT \"retention_time\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE q3"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["retention_time", "VARCHAR(16777216)"]]}},
      {"sql": "SHOW GRANTS TO ROLE r"},
      {"sql": "CREATE TABLE q4 AS SELECT \"granted_on\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE q4"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["granted_on", "VARCHAR(16777216)"]]}},
      {"sql": "SHOW USERS"},
      {"sql": "CREATE TABLE q5 AS SELECT \"mins_to_unlock\", \"days_to_expiry\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))"},
      {"sql": "DESCRIBE TABLE q5"},
      {"sql": "SELECT \"name\", \"type\" FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))",
       "expect": {"rows": [["mins_to_unlock", "VARCHAR(16777216)"], ["days_to_expiry", "VARCHAR(16777216)"]]}},
      {"sql": "DROP ROLE r"},
      {"sql": "DROP USER u"}
    ]},
    {"name": "the-cell-is-a-temporal-value", "steps": [
      {"sql": "CREATE TABLE t (a INT)"},
      {"sql": "SHOW TABLES"},
      {"sql": "SELECT COUNT(*), COUNT_IF(YEAR(\"created_on\") >= 2024) FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))", "expect": {"rows": [["1", "1"]]}},
      {"sql": "SHOW DATABASES"},
      {"sql": "SELECT '<' || MAX(\"retention_time\") || '>' FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE \"name\" = 'TEST_DB'", "expect": {"value": "<1>"}}
    ]}
