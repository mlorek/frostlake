        },
        {
          "sql": "INSERT INTO cb VALUES ('c2','k3')"
        },
        {
          "sql": "SELECT a.region_id, a.item_key FROM ca a UNION ALL SELECT b.region_id, b.item_key FROM cb b ORDER BY region_id, item_key",
          "expect": {
            "rowCount": 3,
            "rows": [
              [
                "c1",
                "k2"
              ],
              [
                "c2",
                "k3"
              ],
              [
                "c3",
                "k1"
              ]
            ],
            "ordered": true
          }
        },
        {
          "sql": "SELECT a.region_id FROM ca a EXCEPT SELECT b.region_id FROM cb b ORDER BY region_id",
          "expect": {
            "rowCount": 2
          }
        }
      ]
