    {
      "name": "a-variant-path-survives-inside-an-if-body",
      "steps": [
        {
          "sql": "CREATE TABLE vt (src VARIANT)"
        },
        {
          "sql": "INSERT INTO vt SELECT PARSE_JSON('{\"a\":{\"b\":7}}')"
        },
        {
          "sql": "CREATE OR REPLACE PROCEDURE p() RETURNS VARCHAR LANGUAGE SQL AS $$\nBEGIN\n  IF (1 = 1) THEN\n    RETURN (SELECT s.src:a:b::VARCHAR FROM vt s);\n  END IF;\n  RETURN 'no';\nEND\n$$"
        },
        {
          "sql": "CALL p()",
          "expect": {
            "value": "7"
          }
        }
      ]
    },
    {
      "name": "a-real-bind-variable-still-substitutes-alongside-a-path",
      "steps": [
        {
          "sql": "CREATE TABLE vt (src VARIANT)"
        },
        {
          "sql": "INSERT INTO vt SELECT PARSE_JSON('{\"a\":{\"b\":7}}')"
        },
        {
          "sql": "CREATE OR REPLACE PROCEDURE p2() RETURNS VARCHAR LANGUAGE SQL AS $$\nDECLARE\n  v VARCHAR DEFAULT 'z';\nBEGIN\n  IF (1 = 1) THEN\n    RETURN (SELECT s.src:a:b::VARCHAR FROM vt s WHERE :v = 'z');\n  END IF;\n  RETURN 'no';\nEND\n$$"
        },
        {
          "sql": "CALL p2()",
          "expect": {
            "value": "7"
          }
        }
      ]
    },
