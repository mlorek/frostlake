    {
      "name": "call-restores-context-without-failing-the-call",
      "steps": [
        {
          "sql": "DROP DATABASE IF EXISTS tools_db"
        },
        {
          "sql": "DROP DATABASE IF EXISTS site_db"
        },
        {
          "sql": "CREATE DATABASE tools_db"
        },
        {
          "sql": "CREATE SCHEMA tools_db.stats"
        },
        {
          "sql": "CREATE OR REPLACE PROCEDURE tools_db.stats.echo(o OBJECT) RETURNS OBJECT LANGUAGE SQL AS $$\nBEGIN\n  RETURN :o;\nEND\n$$"
        },
        {
          "sql": "CREATE DATABASE site_db"
        },
        {
          "sql": "CREATE SCHEMA site_db.tdm"
        },
        {
          "sql": "USE DATABASE site_db"
        },
        {
          "sql": "USE SCHEMA tdm"
        },
        {
          "sql": "USE DATABASE tools_db"
        },
        {
          "sql": "CALL stats.echo(OBJECT_CONSTRUCT('a', 1))",
          "expect": {
            "value": "{\"a\":1}"
          }
        },
        {
          "sql": "USE DATABASE test_db"
        },
        {
          "sql": "USE SCHEMA test_schema"
        },
        {
          "sql": "DROP DATABASE tools_db"
        },
        {
          "sql": "DROP DATABASE site_db"
        }
      ]
