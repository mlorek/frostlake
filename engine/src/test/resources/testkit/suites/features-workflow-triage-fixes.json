        },
        {
          "sql": "SELECT 'diff' AS file_type FROM f WHERE file_type = 'all'",
          "expect": {
            "rowCount": 0
          }
        }
      ]
    },
    {
      "name": "a-real-column-beats-a-same-named-alias-in-where",
      "steps": [
        {
          "sql": "CREATE TABLE g (k VARCHAR, v VARCHAR)"
        },
        {
          "sql": "INSERT INTO g VALUES ('real', 'x')"
        },
        {
          "sql": "SELECT 'alias' AS k, v FROM g WHERE k = 'real'",
          "expect": {
            "rowCount": 1
          }
        },
        {
          "sql": "SELECT 'alias' AS k, v FROM g WHERE k = 'alias'",
          "expect": {
            "rowCount": 0
          }
        }
      ]
    },
    {
      "name": "a-lateral-alias-works-without-a-from-clause",
      "steps": [
        {
          "sql": "SELECT 1 AS x, x + 1 AS y",
          "expect": {
            "rows": [
              [
                "1",
                "2"
              ]
            ]
          }
        }
      ]
    },
    {
      "name": "parse-json-accepts-a-trailing-comma",
      "steps": [
        {
          "sql": "SELECT PARSE_JSON('{\"a\": 1, }')",
          "expect": {
            "value": "{\"a\":1}"
          }
        },
        {
          "sql": "SELECT PARSE_JSON('{\"ip\": {\"IPv4\": [\"1.2.3.4\" ], }}')",
          "expect": {
            "value": "{\"ip\":{\"IPv4\":[\"1.2.3.4\"]}}"
          }
        },
        {
          "sql": "SELECT PARSE_JSON('{\"a\": {\"b\": 7}, }'):a:b::VARCHAR",
          "expect": {
            "value": "7"
          }
        }
      ]
    },
    {
      "name": "parse-json-accepts-a-raw-control-character-in-a-string",
      "steps": [
        {
          "sql": "SELECT LENGTH(PARSE_JSON('{\"k\": \"ab' || CHR(7) || 'cd\"}'):k::VARCHAR)",
          "expect": {
            "value": "5"
          }
        },
        {
          "sql": "SELECT LEFT(PARSE_JSON('{\"k\": \"ab' || CHR(7) || 'cd\"}'):k::VARCHAR, 2)",
          "expect": {
            "value": "ab"
          }
        }
      ]
    },
    {
      "name": "parse-json-still-rejects-genuinely-invalid-text",
      "steps": [
        {
          "sql": "SELECT PARSE_JSON('{not json')",
          "expect": {
            "error": {}
          }
        },
        {
          "sql": "SELECT TRY_PARSE_JSON('{not json') IS NULL",
          "expect": {
            "value": "true"
          }
        },
        {
          "sql": "SELECT PARSE_JSON('{\"a\":[1,2],\"b\":null}')",
          "expect": {
            "value": "{\"a\":[1,2],\"b\":null}"
          }
        }
      ]
    },
    {
      "name": "select-into-targets-survive-inside-an-if-body",
      "steps": [
        {
          "sql": "CREATE TABLE ab (a INTEGER, b INTEGER)"
        },
        {
          "sql": "INSERT INTO ab VALUES (7, 9)"
        },
        {
          "sql": "CREATE OR REPLACE PROCEDURE pinto() RETURNS VARCHAR LANGUAGE SQL AS $$\nDECLARE\n  v1 INTEGER DEFAULT 1;\n  v2 INTEGER DEFAULT 2;\nBEGIN\n  IF (1 = 1) THEN\n    SELECT a, b INTO :v1, :v2 FROM ab;\n  END IF;\n  RETURN :v1::VARCHAR || '/' || :v2::VARCHAR;\nEND\n$$"
        },
        {
          "sql": "CALL pinto()",
          "expect": {
            "value": "7/9"
          }
        }
      ]
    },
    {
      "name": "insert-into-and-ordinary-binds-are-unaffected",
      "steps": [
        {
          "sql": "CREATE TABLE ab (a INTEGER, b INTEGER)"
        },
        {
          "sql": "CREATE OR REPLACE PROCEDURE pins() RETURNS VARCHAR LANGUAGE SQL AS $$\nDECLARE\n  n INTEGER DEFAULT 5;\nBEGIN\n  IF (1 = 1) THEN\n    INSERT INTO ab (a, b) VALUES (:n, :n + 1);\n  END IF;\n  RETURN (SELECT a::VARCHAR || '/' || b::VARCHAR FROM ab);\nEND\n$$"
        },
        {
          "sql": "CALL pins()",
          "expect": {
            "value": "5/6"
          }
        }
      ]
    }
  ]
