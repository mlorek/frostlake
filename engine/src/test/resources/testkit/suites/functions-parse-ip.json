{
  "suite": "functions-parse-ip",
  "description": "PARSE_IP(ip_address, type [, permissive]) parses an IP address into a VARIANT OBJECT. The documented IPv4 CIDR example is pinned member for member. Live-verified shapes: a bare address is NOT treated as /32 - its netmask_prefix_length is null and no range members are reported - the type argument is echoed lowercased as ip_type, and with CIDR the address must BE the network address, so host bits set beyond the prefix are refused (\"Address does not conform to cidr format\") as is a prefix past /32 (\"Network range prefix is too large\"), while INET accepts host bits within the prefix. The permissive flag turns a bad address into an error OBJECT instead of a refusal. IPv6 support is minimal: family 6 with the host echoed and a 128-bit hex rendering. Converted 1:1 from functions/ParseIpTest (now retired); OBJECT results are read directly, which renders identically on the engine and over HTTP.",
  "tags": ["functions", "converted"],
  "tests": [
    {"name": "it-parses-the-documented-ipv4-cidr", "steps": [
      {"sql": "SELECT PARSE_IP('192.168.242.188/24', 'INET')",
       "expect": {"value": "{\"family\":4,\"host\":\"192.168.242.188\",\"ip_fields\":[3232297660,0,0,0],\"ip_type\":\"inet\",\"ipv4\":3232297660,\"ipv4_range_end\":3232297727,\"ipv4_range_start\":3232297472,\"netmask_prefix_length\":24,\"snowflake$type\":\"ip_address\"}"}}
    ]},
    {"name": "a-plain-address-has-a-null-netmask-and-no-range", "steps": [
      {"sql": "SELECT PARSE_IP('10.0.0.5', 'INET')",
       "expect": {"value": "{\"family\":4,\"host\":\"10.0.0.5\",\"ip_fields\":[167772165,0,0,0],\"ip_type\":\"inet\",\"ipv4\":167772165,\"netmask_prefix_length\":null,\"snowflake$type\":\"ip_address\"}"}}
    ]},
    {"name": "the-type-argument-is-echoed-as-ip-type", "steps": [
      {"sql": "SELECT PARSE_IP('192.168.242.0/24', 'CIDR')",
       "expect": {"value": "{\"family\":4,\"host\":\"192.168.242.0\",\"ip_fields\":[3232297472,0,0,0],\"ip_type\":\"cidr\",\"ipv4\":3232297472,\"ipv4_range_end\":3232297727,\"ipv4_range_start\":3232297472,\"netmask_prefix_length\":24,\"snowflake$type\":\"ip_address\"}"}}
    ]},
    {"name": "cidr-rejects-host-bits-and-oversized-prefixes", "steps": [
      {"sql": "SELECT PARSE_IP('192.168.242.188/24', 'CIDR')",
       "expect": {"error": {"messageContains": "Address does not conform to cidr format"}}},
      {"sql": "SELECT PARSE_IP('192.168.242.0/33', 'CIDR')",
       "expect": {"error": {"messageContains": "Network range prefix is too large"}}}
    ]},
    {"name": "cidr-without-a-prefix-has-a-null-netmask-and-no-range", "steps": [
      {"sql": "SELECT PARSE_IP('192.168.242.188', 'CIDR')",
       "expect": {"value": "{\"family\":4,\"host\":\"192.168.242.188\",\"ip_fields\":[3232297660,0,0,0],\"ip_type\":\"cidr\",\"ipv4\":3232297660,\"netmask_prefix_length\":null,\"snowflake$type\":\"ip_address\"}"}}
    ]},
    {"name": "inet-accepts-host-bits-within-the-prefix", "steps": [
      {"sql": "SELECT PARSE_IP('192.168.242.188/24', 'INET')",
       "expect": {"value": "{\"family\":4,\"host\":\"192.168.242.188\",\"ip_fields\":[3232297660,0,0,0],\"ip_type\":\"inet\",\"ipv4\":3232297660,\"ipv4_range_end\":3232297727,\"ipv4_range_start\":3232297472,\"netmask_prefix_length\":24,\"snowflake$type\":\"ip_address\"}"}}
    ]},
    {"name": "permissive-returns-an-error-object-on-bad-input", "steps": [
      {"sql": "SELECT PARSE_IP('999.1.1.1', 'INET', 1)",
       "expect": {"value": "{\"error\":\"Invalid IPv4 address. One or more fields is higher than 255.\"}"}}
    ]},
    {"name": "non-permissive-bad-input-throws", "steps": [
      {"sql": "SELECT PARSE_IP('not.an.ip', 'INET')", "expect": {"error": {}}}
    ]},
    {"name": "ipv6-yields-family-6", "steps": [
      {"sql": "SELECT CONTAINS(TO_VARCHAR(PARSE_IP('2001:db8::1', 'INET')::VARIANT), '\"family\":6')",
       "expect": {"value": "true"}},
      {"sql": "SELECT CONTAINS(TO_VARCHAR(PARSE_IP('2001:db8::1', 'INET')::VARIANT), '\"host\":\"2001:db8::1\"')",
       "expect": {"value": "true"}},
      {"sql": "SELECT CONTAINS(TO_VARCHAR(PARSE_IP('2001:db8::1', 'INET')::VARIANT), '\"hex_ipv6\":')",
       "expect": {"value": "true"}}
    ]},
    {"name": "a-null-input-yields-null", "steps": [
      {"sql": "SELECT PARSE_IP(NULL, 'INET')", "expect": {"rows": [[null]]}}
    ]}
  ]
}
