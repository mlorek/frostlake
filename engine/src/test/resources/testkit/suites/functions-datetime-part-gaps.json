{
  "suite": "functions-datetime-part-gaps",
  "description": "The date/time part functions no other suite names: DAYOFWEEK / WEEK / YEAROFWEEK under the default week policy (WEEK_START counts Sunday as 0), TIMEADD and TIMEDIFF over both TIME and TIMESTAMP values, and TIME_FROM_PARTS including its overflow wrapping - components beyond their range carry over instead of erroring, so TIME_FROM_PARTS(25, 0, 0) is 01:00:00. The week cells are mid-year on purpose, to dodge the January policy edges. Converted 1:1 from functions/DateTimePartGapsTest (now retired).",
  "tags": ["functions", "converted"],
  "tests": [
    {"name": "day-of-week-under-the-default-policy", "steps": [
      {"sql": "SELECT DAYOFWEEK('2026-08-09'::DATE), DAYOFWEEK('2026-08-10'::DATE), DAYOFWEEK('2026-08-15'::DATE)",
       "expect": {"rows": [["0", "1", "6"]]}}
    ]},
    {"name": "week-and-year-of-week-mid-year", "steps": [
      {"sql": "SELECT WEEK('2026-08-10'::DATE), YEAROFWEEK('2026-08-10'::DATE)",
       "expect": {"rows": [["33", "2026"]]}}
    ]},
    {"name": "timeadd-over-time-and-timestamp", "steps": [
      {"sql": "SELECT TIMEADD(minute, 30, '10:00:00'::TIME) = '10:30:00'::TIME", "expect": {"value": "true"}},
      {"sql": "SELECT TIMEADD(hour, -2, '01:00:00'::TIME) = '23:00:00'::TIME", "expect": {"value": "true"}},
      {"sql": "SELECT TIMEADD(day, 1, '2026-01-31 12:00:00'::TIMESTAMP_NTZ) = '2026-02-01 12:00:00'::TIMESTAMP_NTZ",
       "expect": {"value": "true"}}
    ]},
    {"name": "timediff-counts-boundary-crossings", "steps": [
      {"sql": "SELECT TIMEDIFF(minute, '10:00:00'::TIME, '11:30:00'::TIME)", "expect": {"value": "90"}},
      {"sql": "SELECT TIMEDIFF(hour, '11:30:00'::TIME, '10:31:00'::TIME)", "expect": {"value": "-1"}},
      {"sql": "SELECT TIMEDIFF(day, '2026-01-31 23:59:59'::TIMESTAMP_NTZ, '2026-02-01 00:00:00'::TIMESTAMP_NTZ)",
       "expect": {"value": "1"}}
    ]},
    {"name": "time-from-parts-builds-and-wraps", "steps": [
      {"sql": "SELECT TIME_FROM_PARTS(13, 30, 15) = '13:30:15'::TIME", "expect": {"value": "true"}},
      {"sql": "SELECT TIME_FROM_PARTS(10, 90, 0) = '11:30:00'::TIME", "expect": {"value": "true"}},
      {"sql": "SELECT TIME_FROM_PARTS(25, 0, 0) = '01:00:00'::TIME", "expect": {"value": "true"}}
    ]}
  ]
}
