<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.frostlake</groupId>
        <artifactId>frostlake-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>frostlake-db</artifactId>
    <packaging>jar</packaging>

    <name>Frostlake</name>
    <description>An embeddable SQL engine emulating core Snowflake features for local and CI testing.</description>

    <!-- frostlake-db IS published to Central; override the parent's default deploy skip. -->
    <properties>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- Pure-Java snappy/zlib/zstd/bz2 for COMPRESS/DECOMPRESS; no transitive deps.
             Pinned at 2.0.3: advisory GHSA-vx9q-rhv9-3jvg (the Snappy/LZ4 decompressors could leak a
             reused output buffer's contents on malformed input) is fixed there on this line. The
             successor artifact io.airlift:aircompressor-v3 carries the same fix from 3.4, but is
             Java 22+ only (Java 25 bytecode, java.lang.foreign) and bundles native libraries, so it
             cannot be used here. -->
        <dependency>
            <groupId>io.airlift</groupId>
            <artifactId>aircompressor</artifactId>
            <version>2.0.3</version>
        </dependency>

        <!-- ANTLR for SQL parsing -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>

        <!-- JSON support -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>3.2.1</version>
            <scope>compile</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- JLine for interactive console with history support -->
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
            <version>3.30.9</version>
        </dependency>

        <!-- GraalVM polyglot API only (the small language-neutral surface, for TruffleLogBridge). The
             heavyweight language runtimes live in the optional frostlake-rt-js / frostlake-rt-py
             modules and are discovered via the UdfLanguageRuntime ServiceLoader SPI. (See the
             property above for why the versions must match). Python here is GraalPy, a Python 3
             implementation; Snowflake UDFs declare RUNTIME_VERSION 3.x, so the previous Python 2
             interpreter (Jython) could not parse annotations, f-strings or walrus at all. -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graalvm.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>

        <!-- Live-Snowflake test mode only (SF_LIVE=1 routes the test bases' SQL to a real Snowflake
             account instead of the embedded engine). Test scope: the published frostlake-db artifact
             stays free of it. -->
        <dependency>
            <groupId>net.snowflake</groupId>
            <artifactId>snowflake-jdbc</artifactId>
            <version>4.3.2</version>
            <scope>test</scope>
        </dependency>

        <!-- NOTE: the heavy COPY load-format readers (Avro, Parquet, ORC) and their Hadoop/Avro/ORC
             dependencies live in the sibling `frostlake-formats` module, not here. The engine ships only the
             zero-dependency JSON and XML readers and discovers the rest at runtime via a StageFileReader
             ServiceLoader SPI, so `frostlake-db` stays lean (no Hadoop on its classpath). -->
    </dependencies>

    <build>
        <!-- Filter only frostlake-version.properties so the build stamps in ${project.version};
             copy every other resource verbatim (leaving any placeholders in other files untouched). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>frostlake-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>frostlake-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.2</version>
                <configuration>
                    <visitor>true</visitor>
                    <listener>true</listener>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <argLine>-Dpolyglot.engine.WarnInterpreterOnly=false</argLine>
                    <excludedGroups>${perf.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- Publish a test-jar so the perf-tests module can reuse BaseDatabaseTest and other
                 shared test infrastructure. Bound to test-compile so the artifact is available to
                 downstream reactor modules during `mvn test` as well as `mvn verify`. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>make-test-jar</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- License-header audit (Apache RAT): fails the build at `verify` if any engine-owned
                 .java file (dev.frostlake main/test + the com.snowflake.snowpark_java stubs) is
                 missing the Apache-2.0 header. Standalone:  mvn apache-rat:check -->
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>${apache-rat-plugin.version}</version>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <!-- RAT 0.17+ scans every file not excluded (the pre-0.17 "<includes> restricts the
                         scan" semantics are gone, and an excluded directory is pruned before includes can
                         override). So instead of listing the audited .java sets, exclude the non-audited
                         categories; everything left IS the owned Java source, and new .java files are
                         audited automatically wherever they appear. -->
                    <inputExcludes>
                        <inputExclude>/pom.xml</inputExclude>
                        <inputExclude>/.flattened-pom.xml</inputExclude>
                        <inputExclude>/src/main/antlr4/**</inputExclude>
                        <inputExclude>/src/main/resources/**</inputExclude>
                        <inputExclude>/src/test/resources/**</inputExclude>
                        <inputExclude>**/*.md</inputExclude>
                        <inputExclude>**/*.log</inputExclude>
                    </inputExcludes>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Third-party dependency-license report. Run on demand:
                   mvn license:add-third-party
                 -> target/generated-sources/license/THIRD-PARTY.txt (shipped compile/runtime deps only). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.3.0</version>
                <configuration>
                    <excludedScopes>test,provided</excludedScopes>
                    <outputDirectory>${project.build.directory}/generated-sources/license</outputDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
