<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.frostlake</groupId>
    <artifactId>frostlake-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Frostlake (parent)</name>
    <description>Multi-module build for Frostlake — an embeddable SQL engine emulating core Snowflake features for local and CI testing.</description>
    <url>https://frostlake.dev</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mlorek</id>
            <name>MLorek</name>
            <url>https://frostlake.dev</url>
        </developer>
        <developer>
            <id>AnnisL</id>
            <name>AnnisL</name>
            <url>https://frostlake.dev</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/mlorek/frostlake.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/mlorek/frostlake.git</developerConnection>
        <url>https://github.com/mlorek/frostlake</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>engine</module>
        <module>ai</module>
        <module>formats</module>
        <module>geo</module>
        <module>perf-tests</module>
        <module>rt-js</module>
        <module>rt-py</module>
        <module>rt-scala</module>
    </modules>

    <properties>
        <!-- Single source of truth for the project version (Maven "CI-friendly" ${revision}). Every module
             inherits it via <parent><version>${revision}</version>; bump here (or pass -Drevision=X). The
             flatten-maven-plugin below rewrites ${revision} to a literal in the installed/deployed poms so
             consumers never see the placeholder. -->
        <revision>0.1.1-SNAPSHOT</revision>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Perf harnesses are @Tag("perf"); excluded by default, included via the perf/perf-mem
             profiles defined in the perf-tests module. -->
        <perf.excludedGroups>perf</perf.excludedGroups>
        <!-- One RAT (license-header audit) version for every module. NOTE: RAT 0.17+ changed scan
             semantics — module configs must use <inputExclude> (see the engine pom for the details). -->
        <apache-rat-plugin.version>0.18</apache-rat-plugin.version>
        <!-- Checkstyle audits the house rules; see the plugin declaration for why it is unbound. -->
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>11.1.0</checkstyle.version>
        <!-- One Truffle line for every polyglot language. 25.0.2 keeps Java 17 base classes AND is the
             version downstream builds (e.g. the vendor test harness) already put on the classpath — a
             consumer resolving "newest wins" must not end up with our Python on a different Truffle
             than its JS, which breaks Truffle library initialization at context startup.
             DO NOT bump to 25.1.x while the build targets Java 17: 25.1 expects JDK 21+, loses native
             access on 17 (TruffleAttach "unsupported JNI version" warning) and GraalPy datetime interop
             NPEs ("moduleState is null" — see PythonSemiStructuredArgumentTest). The GraalPy venv used
             for numpy/pandas (python.venv) is also built with GraalPy 25.0.2 and must match. -->
        <graalvm.version>25.0.2</graalvm.version>
        <!-- Publishing (see the release profile below): SEVEN modules publish to Central, each overriding
             this to false — frostlake-db (the engine) and the six optional packs frostlake-ai,
             frostlake-formats, frostlake-geo, frostlake-rt-js, frostlake-rt-py and frostlake-rt-scala.
             Only the aggregator parent and the perf-tests harness keep it true. The
             central-publishing-maven-plugin honours maven.deploy.skip, so a skipped module is left out of
             the release bundle. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <build>
        <plugins>
            <!-- Resolve the ${revision} CI-friendly version to a literal in the published pom of every module,
                 and (flattenMode=oss) inline the inherited Central-required metadata — name, description, url,
                 licenses, developers, scm — into each published pom while dropping the <parent> reference. This
                 makes every deployed artifact's pom self-contained and Maven-Central-valid on its own, so the
                 aggregator parent need not be published for consumers to resolve those elements. Inherited by
                 all children. Without it, install/deploy would emit poms containing a raw ${revision}. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle audits the house rules in config/checkstyle/checkstyle.xml. Deliberately
                 NOT bound to a lifecycle phase: an ordinary `mvn test` or `mvn verify` stays as fast
                 as it was, and CI invokes `mvn checkstyle:check` explicitly at the END of the run
                 (the hygiene suite, beside the banned-term and import sweeps). It only ever REPORTS —
                 there is no formatting goal here and none should be added.

                 Rules the tree already satisfies are errors and fail the build; rules with a measured
                 backlog are warnings, so violationSeverity=error keeps CI green while the counts stay
                 visible on every run. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
                    <suppressionsFileExpression>checkstyle.suppressions.file</suppressionsFileExpression>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <logViolationsToConsole>true</logViolationsToConsole>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Release/publish profile (activate with -Prelease). Lives here in the parent so EVERY published
             module — the engine plus the six optional packs, seven jars in all — inherits the same
             source + javadoc + GPG attach and the central-publishing hookup, and each publishes as its own
             separate jar. The aggregator parent and perf-tests keep maven.deploy.skip=true, so they are left
             out of the bundle. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <!--
                              Lint everything javadoc can check EXCEPT the "missing" group, and fail the
                              release when it finds something.

                              The two halves are different in kind. A missing @param or an undocumented
                              accessor is a style choice — this codebase documents in prose, on the types
                              and methods where the reasoning lives, so several hundred such warnings are
                              expected and say nothing. The rest are DEFECTS that silently mangle the
                              published HTML: a bare `<query_id>` or `Supplier<ResultSet>` in prose is
                              parsed as an HTML tag and swallows the text after it, an unbalanced brace
                              inside {@code ...} eats the closing delimiter, and a broken {@link} points
                              nowhere. Those are worth a build failure; they used to be tolerated only
                              because failOnError hid them.
                            -->
                            <doclint>all,-missing</doclint>
                            <failOnError>true</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
